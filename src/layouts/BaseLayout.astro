---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ZaloFloat from '../components/ZaloFloat.astro';
import { url } from '../lib/url';

interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>;
  // Ảnh dùng khi chia sẻ lên mạng xã hội (ví dụ ảnh đại diện của bài). Không có thì dùng ảnh bìa mặc định.
  image?: ImageMetadata;
  // true = báo cho Google không lập chỉ mục trang này (dùng cho bài "bản xem thử" chưa kiểm duyệt)
  noindex?: boolean;
}

const SITE_NAME = 'Dược Sĩ Thương';
const { title, description, jsonLd, image, noindex } = Astro.props;
const fullTitle = title === SITE_NAME ? title : `${title} | ${SITE_NAME}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Ảnh chia sẻ mạng xã hội (1200x630): ảnh đại diện của bài nếu có, không thì ảnh bìa mặc định
const shareImage = image
  ? await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg' })
  : undefined;
const ogImage = new URL(shareImage ? shareImage.src : url('/og-image.jpg'), Astro.site);
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={url('/favicon.png')} />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Bỏ qua để đến nội dung chính</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <ZaloFloat />
  </body>
</html>
