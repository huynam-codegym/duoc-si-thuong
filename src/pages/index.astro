---
import { Image } from 'astro:assets';
import cover from '../assets/cover.jpg';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import ProductCard from '../components/ProductCard.astro';
import GroupIcon from '../components/GroupIcon.astro';
import VideoSection from '../components/VideoSection.astro';
import CampaignBanner from '../components/CampaignBanner.astro';
import { campaignActive } from '../lib/campaign';
import { getAudiences } from '../lib/audiences';
import { categories } from '../lib/categories';
import { departments, departmentSlugs, getProductGroups, groupWithChildren } from '../lib/departments';
import FlashSale from '../components/FlashSale.astro';
import { flashSaleActive } from '../lib/flash-sale';
import { getPosts } from '../lib/posts';
import { getProducts } from '../lib/products';
import { seasonalTopics } from '../lib/seasonal';
import { site } from '../lib/site';
import { url } from '../lib/url';
import { videos } from '../lib/videos';

const latest = (await getPosts()).slice(0, 6);
const audiences = await getAudiences();

// Với mỗi khu bán hàng: chỉ hiện phần "Danh mục sản phẩm"/"Sản phẩm" khi khu đó đã có sản phẩm thật
const shops = await Promise.all(
  departmentSlugs.map(async (slug) => {
    const products = await getProducts(slug);
    // Không giới hạn cứng ở đây nữa — trang chủ tự hiện 12 (máy tính)/16 (điện thoại) sản phẩm đầu,
    // có nút "Xem thêm" tải tiếp theo từng đợt (xem script cuối trang và CSS .carousel-wide).
    return { slug, department: departments[slug], groups: getProductGroups(slug), featured: products };
  }),
);
const activeShops = shops.filter((shop) => shop.featured.length > 0);

// "Danh mục nổi bật" (04/11/2026, chủ website yêu cầu thay cho "Danh mục [khu]" của từng khu và "Sản phẩm
// theo nhu cầu", vì hiện quá nhiều): 12 nhóm CẤP CAO NHẤT (không tính nhóm con) có nhiều sản phẩm nhất ở cả
// 4 khu, số đếm cộng dồn cả sản phẩm của nhóm con (giống menu trái). Nhóm chưa có sản phẩm thì không hiện.
const allProducts = shops.flatMap((shop) => shop.featured);
const featuredGroups = departmentSlugs
  .flatMap((deptSlug) => {
    const groups = getProductGroups(deptSlug);
    const childSlugs = new Set(groups.flatMap(([, group]) => group.childGroups ?? []));
    return groups
      .filter(([groupSlug]) => !childSlugs.has(groupSlug))
      .map(([groupSlug, group]) => {
        const slugs = groupWithChildren(deptSlug, groupSlug);
        const count = allProducts.filter((p) => p.data.department === deptSlug && slugs.includes(p.data.group)).length;
        return { deptSlug, groupSlug, group, count };
      });
  })
  .filter((entry) => entry.count > 0)
  .sort((a, b) => b.count - a.count || a.group.name.localeCompare(b.group.name, 'vi'))
  .slice(0, 12);

// "Bệnh thường gặp theo mùa": mỗi tab là một bệnh (nhóm con của chuyên mục an-uong), kèm đoạn giới
// thiệu ngắn và (nếu có khai báo) sản phẩm hỗ trợ thật thuộc nhóm liên quan. Xem src/lib/seasonal.ts.
const seasonal = await Promise.all(
  seasonalTopics.map(async (topic) => {
    const group = categories['an-uong'].groups?.[topic.groupSlug];
    const products = topic.productSource
      ? (await getProducts(topic.productSource.department, topic.productSource.group)).slice(0, 4)
      : [];
    return { ...topic, group, products };
  }),
);
---

<BaseLayout
  title="Dược Sĩ Thương"
  description="Hơn 10 năm kinh nghiệm, dược sĩ Thương chia sẻ kiến thức ăn uống, phòng bệnh, dùng thuốc an toàn và đồng hành cùng bố mẹ chăm con phát triển chiều cao."
>
  <div class="container">
    <h1 class="visually-hidden">Dược Sĩ Thương</h1>
    <div class="banner-wrap">
      <Image
        class="banner"
        src={cover}
        alt="Dược sĩ Thương, dược sĩ đồng hành chăm sóc sức khỏe gia đình bạn. Hơn 10 năm kinh nghiệm tư vấn sức khỏe. Liên hệ: 0988 283 415."
        widths={[640, 1024, 1400, 2048]}
        sizes="(min-width: 68rem) 1088px, 100vw"
        quality={85}
        loading="eager"
      />
      <!-- Vùng bấm trong suốt phủ lên khối số điện thoại trong ảnh bìa (vị trí tính theo % ảnh gốc 2048x762) -->
      <a
        class="banner-cta"
        href={site.zaloHref}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Liên hệ dược sĩ Thương qua Zalo: ${site.phone}`}></a>
    </div>

    <ul class="trust">
      <li><GroupIcon icon="doctor" size={18} /> Dược sĩ đại học tư vấn</li>
      <li><GroupIcon icon="chat" size={18} /> Nhắn Zalo hỏi đáp: {site.phone}</li>
      <li><GroupIcon icon="book" size={18} /> Bài viết có nguồn tham khảo</li>
    </ul>

    <ul class="quick-tiles">
      <li>
        <a href={site.zaloHref} target="_blank" rel="noopener noreferrer">
          <GroupIcon icon="doctor" size={24} badge badgeSize={48} />
          <span>Tư vấn dược sĩ</span>
        </a>
      </li>
      <li>
        <a href={url('/thuc-pham-chuc-nang/')}>
          <GroupIcon icon="cart" size={24} badge badgeSize={48} />
          <span>Thực phẩm chức năng</span>
        </a>
      </li>
      <li>
        <a href={url('/an-uong/')}>
          <GroupIcon icon="salad" size={24} badge badgeSize={48} />
          <span>Ăn uống & dinh dưỡng</span>
        </a>
      </li>
      <li>
        <a href={url('/kien-thuc-ve-thuoc/')}>
          <GroupIcon icon="capsule" size={24} badge badgeSize={48} />
          <span>Thuốc</span>
        </a>
      </li>
      <li>
        <a href={url('/gio-hang/')}>
          <GroupIcon icon="cart" size={24} badge badgeSize={48} />
          <span>Giỏ hàng</span>
        </a>
      </li>
      <li>
        <a href={url('/gioi-thieu/')}>
          <GroupIcon icon="shield" size={24} badge badgeSize={48} />
          <span>Giới thiệu</span>
        </a>
      </li>
    </ul>

    {/* Chương trình theo dịp (src/lib/campaign.ts): hết hạn thì không dựng nữa, banner cũng tự ẩn ở trình duyệt */}
    {/* Flash Sale theo khung giờ (src/lib/flash-sale.ts): hết mọi khung giờ thì không dựng nữa, khung cũng tự ẩn ở trình duyệt */}
    {flashSaleActive() && <FlashSale />}

    {campaignActive() && <CampaignBanner />}

    {
      featuredGroups.length > 0 && (
        <section aria-labelledby="danh-muc-noi-bat">
          <h2 class="section-title" id="danh-muc-noi-bat"><GroupIcon icon="grid" size={22} /> Danh mục nổi bật</h2>
          <ul class="featured-cats">
            {featuredGroups.map(({ deptSlug, groupSlug, group, count }) => (
              <li>
                <a href={url(`/${deptSlug}/nhom/${groupSlug}/`)}>
                  <GroupIcon icon={group.icon} size={30} badge badgeSize={56} />
                  <strong>{group.name}</strong>
                  <span>{count} sản phẩm</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      audiences.length > 0 && (
        <section aria-labelledby="mua-theo-doi-tuong">
          <h2 class="section-title" id="mua-theo-doi-tuong"><GroupIcon icon="target" size={22} /> Mua theo đối tượng</h2>
          <ul class="featured-cats audience-cats">
            {audiences.map((audience) => (
              <li>
                <a href={url(`/doi-tuong/${audience.slug}/`)}>
                  <GroupIcon icon={audience.icon} size={30} badge badgeSize={56} />
                  <strong>{audience.name}</strong>
                  <small>{audience.description}</small>
                  <span>{audience.products.length} sản phẩm</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      /* Thứ tự trang chủ: khu bán hàng lên đầu (tháng 9/2026). Từ 04/11/2026 bỏ "Danh mục [khu]" của từng khu
         và "Sản phẩm theo nhu cầu" (chủ website thấy hiện quá nhiều), thay bằng 1 mục "Danh mục nổi bật" ở trên. */
      activeShops.map((shop) => (
        <>
          <section aria-labelledby={`sp-${shop.slug}`}>
            <h2 class="section-title" id={`sp-${shop.slug}`}><GroupIcon icon="cart" size={22} /> {shop.department.name}</h2>
            <div class="carousel carousel-wide">
              <div class="carousel-track">
                {shop.featured.map((product) => (
                  <div class="carousel-item">
                    <ProductCard product={product} />
                  </div>
                ))}
              </div>
            </div>
            {shop.featured.length > 12 && (
              <p class="carousel-more">
                <button type="button" class="btn btn-outline carousel-more-btn">Xem thêm sản phẩm</button>
              </p>
            )}
            <p class="more">
              <a class="btn btn-outline" href={url(`/${shop.slug}/`)}>Xem tất cả {shop.department.name.toLowerCase()}</a>
            </p>
          </section>
        </>
      ))
    }

    <section aria-labelledby="benh-theo-mua">
      <h2 class="section-title" id="benh-theo-mua"><GroupIcon icon="calendar" size={22} /> Bệnh thường gặp theo mùa</h2>
      <div class="season-card">
        <div class="season-tabs" role="tablist">
          {seasonal.map((topic, index) => topic.group && (
            <button
              type="button"
              class={`season-tab${index === 0 ? ' active' : ''}`}
              data-panel={`season-${index}`}
              role="tab"
              aria-selected={index === 0 ? 'true' : 'false'}
            >
              <GroupIcon icon={topic.group.icon} size={17} />
              <span>{topic.group.name}</span>
            </button>
          ))}
        </div>
        {seasonal.map((topic, index) => topic.group && (
          <div class={`season-panel${index === 0 ? ' active' : ''}`} data-panel={`season-${index}`} role="tabpanel">
            <div class="season-layout">
              <div class="season-info">
                <span class="season-icon"><GroupIcon icon={topic.group.icon} size={36} /></span>
                <p>{topic.summary}</p>
                <a class="btn" href={url(`/an-uong/${topic.postSlug}/`)}>Xem dấu hiệu &amp; cách chăm sóc</a>
              </div>
              <div class="season-products">
                {topic.products.length > 0 ? (
                  <div class="carousel">
                    <div class="carousel-track">
                      {topic.products.map((product) => (
                        <div class="carousel-item">
                          <ProductCard product={product} />
                        </div>
                      ))}
                    </div>
                  </div>
                ) : (
                  <p class="empty">
                    Sản phẩm hỗ trợ liên quan đang được cập nhật.{' '}
                    <a href={site.zaloHref} target="_blank" rel="noopener noreferrer">Nhắn Zalo hỏi dược sĩ</a> nếu cần tư vấn ngay.
                  </p>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
      <p class="season-disclaimer">
        Sản phẩm gợi ý chỉ mang tính hỗ trợ, không phải thuốc và không thay thế khám, chẩn đoán hay điều trị của bác sĩ.
      </p>
    </section>

    {videos.length > 0 && <VideoSection videos={videos} />}

    <section aria-labelledby="chuyen-muc">
      <h2 class="section-title" id="chuyen-muc">Góc sức khỏe: chuyên mục kiến thức</h2>
      <div class="grid">
        {
          Object.entries(categories).map(([slug, category]) => (
            <a class="card" href={url(`/${slug}/`)}>
              <h3>{category.name}</h3>
              <p>{category.description}</p>
            </a>
          ))
        }
      </div>
    </section>

    <section aria-labelledby="bai-moi">
      <h2 class="section-title" id="bai-moi">Bài viết mới</h2>
      {
        latest.length > 0 ? (
          <div class="grid">
            {latest.map((post) => <PostCard post={post} />)}
          </div>
        ) : (
          <p class="empty">Các bài viết đang được biên soạn và kiểm duyệt. Mời bạn quay lại sau.</p>
        )
      }
    </section>
  </div>
</BaseLayout>

<script>
  import { initProductLoadMoreGrids } from '../lib/product-grid';

  // Khối sản phẩm RỘNG (.carousel-wide — không gồm khối hẹp trong "Bệnh thường gặp theo mùa"): hiện
  // lưới 2/4 cột kèm nút "Xem thêm sản phẩm", dùng chung với trang khu bán hàng và trang nhóm sản
  // phẩm — xem chi tiết cách hoạt động trong src/lib/product-grid.ts.
  initProductLoadMoreGrids();

  // Thẻ "Bệnh thường gặp theo mùa": bấm để chuyển bệnh đang xem
  document.querySelectorAll<HTMLButtonElement>('.season-tab').forEach((tab) => {
    tab.addEventListener('click', () => {
      const panel = tab.dataset.panel;
      document.querySelectorAll<HTMLElement>('.season-tab').forEach((t) => {
        const active = t.dataset.panel === panel;
        t.classList.toggle('active', active);
        t.setAttribute('aria-selected', String(active));
      });
      document.querySelectorAll<HTMLElement>('.season-panel').forEach((p) => p.classList.toggle('active', p.dataset.panel === panel));
    });
  });
</script>
