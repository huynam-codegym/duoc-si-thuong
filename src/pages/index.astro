---
import { Image } from 'astro:assets';
import cover from '../assets/cover.jpg';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import ProductCard from '../components/ProductCard.astro';
import GroupIcon from '../components/GroupIcon.astro';
import VideoSection from '../components/VideoSection.astro';
import { categories } from '../lib/categories';
import { departments, departmentSlugs, getProductGroups } from '../lib/departments';
import { getPosts } from '../lib/posts';
import { getProducts } from '../lib/products';
import { seasonalTopics } from '../lib/seasonal';
import { site } from '../lib/site';
import { url } from '../lib/url';
import { videos } from '../lib/videos';

const latest = (await getPosts()).slice(0, 6);

// Với mỗi khu bán hàng: chỉ hiện phần "Danh mục sản phẩm"/"Sản phẩm" khi khu đó đã có sản phẩm thật
const shops = await Promise.all(
  departmentSlugs.map(async (slug) => {
    const products = await getProducts(slug);
    return { slug, department: departments[slug], groups: getProductGroups(slug), featured: products.slice(0, 8) };
  }),
);
const activeShops = shops.filter((shop) => shop.featured.length > 0);

// "Sản phẩm theo nhu cầu": gộp các NHÓM (ở bất kỳ khu nào) đã có sản phẩm thật, thành các thẻ để bấm chuyển.
// Không gắn theo tên bệnh cụ thể (tránh hiểu nhầm "sản phẩm chữa bệnh X"); tự ẩn khi chưa nhóm nào có sản phẩm.
const needTabsRaw = await Promise.all(
  departmentSlugs.flatMap((deptSlug) =>
    getProductGroups(deptSlug).map(async ([groupSlug, group]) => {
      const products = await getProducts(deptSlug, groupSlug);
      return { deptSlug, groupSlug, group, products: products.slice(0, 8) };
    }),
  ),
);
const needTabs = needTabsRaw.filter((tab) => tab.products.length > 0);

// "Bệnh thường gặp theo mùa": mỗi tab là một bệnh (nhóm con của chuyên mục an-uong), kèm đoạn giới
// thiệu ngắn và (nếu có khai báo) sản phẩm hỗ trợ thật thuộc nhóm liên quan. Xem src/lib/seasonal.ts.
const seasonal = await Promise.all(
  seasonalTopics.map(async (topic) => {
    const group = categories['an-uong'].groups?.[topic.groupSlug];
    const products = topic.productSource
      ? (await getProducts(topic.productSource.department, topic.productSource.group)).slice(0, 4)
      : [];
    return { ...topic, group, products };
  }),
);
---

<BaseLayout
  title="Dược Sĩ Thương"
  description="Chia sẻ kiến thức về ăn uống lành mạnh, cách nhận biết bệnh, cách phòng chống bệnh và dùng thuốc an toàn."
>
  <div class="container">
    <h1 class="visually-hidden">Dược Sĩ Thương</h1>
    <div class="banner-wrap">
      <Image
        class="banner"
        src={cover}
        alt="Dược sĩ Thương, dược sĩ đồng hành chăm sóc sức khỏe gia đình bạn. Hơn 10 năm kinh nghiệm tư vấn sức khỏe. Liên hệ: 0988 283 415."
        widths={[640, 1024, 1400, 2048]}
        sizes="(min-width: 68rem) 1088px, 100vw"
        quality={85}
        loading="eager"
      />
      <!-- Vùng bấm trong suốt phủ lên khối số điện thoại trong ảnh bìa (vị trí tính theo % ảnh gốc 2048x762) -->
      <a
        class="banner-cta"
        href={site.zaloHref}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Liên hệ dược sĩ Thương qua Zalo: ${site.phone}`}></a>
    </div>

    <ul class="trust">
      <li><GroupIcon icon="doctor" size={18} /> Dược sĩ đại học tư vấn</li>
      <li><GroupIcon icon="chat" size={18} /> Nhắn Zalo hỏi đáp: {site.phone}</li>
      <li><GroupIcon icon="book" size={18} /> Bài viết có nguồn tham khảo</li>
    </ul>

    <ul class="quick-tiles">
      <li>
        <a href={site.zaloHref} target="_blank" rel="noopener noreferrer">
          <GroupIcon icon="doctor" size={24} badge badgeSize={48} />
          <span>Tư vấn dược sĩ</span>
        </a>
      </li>
      <li>
        <a href={url('/thuc-pham-chuc-nang/')}>
          <GroupIcon icon="cart" size={24} badge badgeSize={48} />
          <span>Thực phẩm chức năng</span>
        </a>
      </li>
      <li>
        <a href={url('/an-uong/')}>
          <GroupIcon icon="salad" size={24} badge badgeSize={48} />
          <span>Ăn uống & dinh dưỡng</span>
        </a>
      </li>
      <li>
        <a href={url('/kien-thuc-ve-thuoc/')}>
          <GroupIcon icon="capsule" size={24} badge badgeSize={48} />
          <span>Thuốc</span>
        </a>
      </li>
      <li>
        <a href={url('/gio-hang/')}>
          <GroupIcon icon="cart" size={24} badge badgeSize={48} />
          <span>Giỏ hàng</span>
        </a>
      </li>
      <li>
        <a href={url('/gioi-thieu/')}>
          <GroupIcon icon="shield" size={24} badge badgeSize={48} />
          <span>Giới thiệu</span>
        </a>
      </li>
    </ul>

    <section aria-labelledby="benh-theo-mua">
      <h2 class="section-title" id="benh-theo-mua">Bệnh thường gặp theo mùa</h2>
      <div class="season-card">
        <div class="season-tabs" role="tablist">
          {seasonal.map((topic, index) => topic.group && (
            <button
              type="button"
              class={`season-tab${index === 0 ? ' active' : ''}`}
              data-panel={`season-${index}`}
              role="tab"
              aria-selected={index === 0 ? 'true' : 'false'}
            >
              <GroupIcon icon={topic.group.icon} size={17} />
              <span>{topic.group.name}</span>
            </button>
          ))}
        </div>
        {seasonal.map((topic, index) => topic.group && (
          <div class={`season-panel${index === 0 ? ' active' : ''}`} data-panel={`season-${index}`} role="tabpanel">
            <div class="season-layout">
              <div class="season-info">
                <span class="season-icon"><GroupIcon icon={topic.group.icon} size={36} /></span>
                <p>{topic.summary}</p>
                <a class="btn" href={url(`/an-uong/${topic.postSlug}/`)}>Xem dấu hiệu &amp; cách chăm sóc</a>
              </div>
              <div class="season-products">
                {topic.products.length > 0 ? (
                  <div class="carousel">
                    <div class="carousel-track">
                      {topic.products.map((product) => (
                        <div class="carousel-item">
                          <ProductCard product={product} />
                        </div>
                      ))}
                    </div>
                  </div>
                ) : (
                  <p class="empty">
                    Sản phẩm hỗ trợ liên quan đang được cập nhật.{' '}
                    <a href={site.zaloHref} target="_blank" rel="noopener noreferrer">Nhắn Zalo hỏi dược sĩ</a> nếu cần tư vấn ngay.
                  </p>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
      <p class="season-disclaimer">
        Sản phẩm gợi ý chỉ mang tính hỗ trợ, không phải thuốc và không thay thế khám, chẩn đoán hay điều trị của bác sĩ.
      </p>
    </section>

    {
      needTabs.length > 0 && (
        <section aria-labelledby="theo-nhu-cau">
          <h2 class="section-title" id="theo-nhu-cau">Sản phẩm theo nhu cầu</h2>
          <div class="need-tabs" role="tablist">
            {needTabs.map((tab, index) => (
              <button
                type="button"
                class={`need-tab${index === 0 ? ' active' : ''}`}
                data-panel={`need-${index}`}
                role="tab"
                aria-selected={index === 0 ? 'true' : 'false'}
              >
                <GroupIcon icon={tab.group.icon} size={17} />
                <span>{tab.group.name}</span>
              </button>
            ))}
          </div>
          {needTabs.map((tab, index) => (
            <div class={`need-panel${index === 0 ? ' active' : ''}`} data-panel={`need-${index}`} role="tabpanel">
              <div class="carousel">
                {tab.products.length > 4 && (
                  <button type="button" class="carousel-btn carousel-prev" data-dir="-1" aria-label="Xem sản phẩm trước">‹</button>
                )}
                <div class="carousel-track">
                  {tab.products.map((product) => (
                    <div class="carousel-item">
                      <ProductCard product={product} />
                    </div>
                  ))}
                </div>
                {tab.products.length > 4 && (
                  <button type="button" class="carousel-btn carousel-next" data-dir="1" aria-label="Xem sản phẩm sau">›</button>
                )}
              </div>
              <p class="more">
                <a class="btn btn-outline" href={url(`/${tab.deptSlug}/nhom/${tab.groupSlug}/`)}>
                  Xem tất cả {tab.group.name.toLowerCase()}
                </a>
              </p>
            </div>
          ))}
        </section>
      )
    }

    {
      activeShops.map((shop) => (
        <>
          <section aria-labelledby={`danh-muc-${shop.slug}`}>
            <h2 class="section-title" id={`danh-muc-${shop.slug}`}>
              Danh mục {shop.department.name.toLowerCase()}
            </h2>
            <ul class="cat-tiles">
              {shop.groups.map(([groupSlug, group]) => (
                <li>
                  <a href={url(`/${shop.slug}/nhom/${groupSlug}/`)}>
                    <span class="tile-icon" aria-hidden="true">
                      <GroupIcon icon={group.icon} size={26} badge badgeSize={52} />
                    </span>
                    <span>{group.name}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>

          <section aria-labelledby={`sp-${shop.slug}`}>
            <h2 class="section-title" id={`sp-${shop.slug}`}>{shop.department.name}</h2>
            <div class="carousel">
              {shop.featured.length > 4 && (
                <button type="button" class="carousel-btn carousel-prev" data-dir="-1" aria-label="Xem sản phẩm trước">‹</button>
              )}
              <div class="carousel-track">
                {shop.featured.map((product) => (
                  <div class="carousel-item">
                    <ProductCard product={product} />
                  </div>
                ))}
              </div>
              {shop.featured.length > 4 && (
                <button type="button" class="carousel-btn carousel-next" data-dir="1" aria-label="Xem sản phẩm sau">›</button>
              )}
            </div>
            <p class="more">
              <a class="btn btn-outline" href={url(`/${shop.slug}/`)}>Xem tất cả {shop.department.name.toLowerCase()}</a>
            </p>
          </section>
        </>
      ))
    }

    {videos.length > 0 && <VideoSection videos={videos} />}

    <section aria-labelledby="chuyen-muc">
      <h2 class="section-title" id="chuyen-muc">Góc sức khỏe: chuyên mục kiến thức</h2>
      <div class="grid">
        {
          Object.entries(categories).map(([slug, category]) => (
            <a class="card" href={url(`/${slug}/`)}>
              <h3>{category.name}</h3>
              <p>{category.description}</p>
            </a>
          ))
        }
      </div>
    </section>

    <section aria-labelledby="bai-moi">
      <h2 class="section-title" id="bai-moi">Bài viết mới</h2>
      {
        latest.length > 0 ? (
          <div class="grid">
            {latest.map((post) => <PostCard post={post} />)}
          </div>
        ) : (
          <p class="empty">Các bài viết đang được biên soạn và kiểm duyệt. Mời bạn quay lại sau.</p>
        )
      }
    </section>
  </div>
</BaseLayout>

<script>
  // Nút mũi tên cho khối sản phẩm cuộn ngang (vuốt tay vẫn dùng được, nút chỉ là tiện thêm)
  document.querySelectorAll<HTMLElement>('.carousel').forEach((carousel) => {
    const track = carousel.querySelector<HTMLElement>('.carousel-track');
    carousel.querySelectorAll<HTMLButtonElement>('.carousel-btn').forEach((button) => {
      button.addEventListener('click', () => {
        track?.scrollBy({ left: Number(button.dataset.dir) * (track.clientWidth * 0.8), behavior: 'smooth' });
      });
    });
  });

  // Thẻ "Sản phẩm theo nhu cầu": bấm để chuyển nhóm đang xem
  document.querySelectorAll<HTMLButtonElement>('.need-tab').forEach((tab) => {
    tab.addEventListener('click', () => {
      const panel = tab.dataset.panel;
      document.querySelectorAll<HTMLElement>('.need-tab').forEach((t) => {
        const active = t.dataset.panel === panel;
        t.classList.toggle('active', active);
        t.setAttribute('aria-selected', String(active));
      });
      document.querySelectorAll<HTMLElement>('.need-panel').forEach((p) => p.classList.toggle('active', p.dataset.panel === panel));
    });
  });

  // Thẻ "Bệnh thường gặp theo mùa": bấm để chuyển bệnh đang xem
  document.querySelectorAll<HTMLButtonElement>('.season-tab').forEach((tab) => {
    tab.addEventListener('click', () => {
      const panel = tab.dataset.panel;
      document.querySelectorAll<HTMLElement>('.season-tab').forEach((t) => {
        const active = t.dataset.panel === panel;
        t.classList.toggle('active', active);
        t.setAttribute('aria-selected', String(active));
      });
      document.querySelectorAll<HTMLElement>('.season-panel').forEach((p) => p.classList.toggle('active', p.dataset.panel === panel));
    });
  });
</script>
