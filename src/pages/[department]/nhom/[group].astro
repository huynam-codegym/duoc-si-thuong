---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ShopShell from '../../../components/ShopShell.astro';
import GroupIcon from '../../../components/GroupIcon.astro';
import ProductCard from '../../../components/ProductCard.astro';
import ProductNotice from '../../../components/ProductNotice.astro';
import { departments, departmentSlugs, getProductGroups, type DepartmentSlug } from '../../../lib/departments';
import { getProducts } from '../../../lib/products';

export function getStaticPaths() {
  return departmentSlugs.flatMap((department) =>
    getProductGroups(department).map(([group]) => ({ params: { department, group } })),
  );
}

const departmentSlug = Astro.params.department as DepartmentSlug;
const groupSlug = Astro.params.group as string;
const department = departments[departmentSlug];
const group = department.groups[groupSlug];
const products = await getProducts(departmentSlug, groupSlug);
---

<BaseLayout title={`${group.name} | ${department.name}`} description={group.description}>
  <ShopShell department={departmentSlug} current={groupSlug}>
    <section class="hero shop-hero">
      <h1><GroupIcon icon={group.icon} size={28} badge badgeSize={44} /> {group.name}</h1>
      <p>{group.description}</p>
    </section>
    <ProductNotice department={departmentSlug} short />

    {
      products.length > 0 ? (
        <>
          <div class="carousel carousel-wide">
            <div class="carousel-track">
              {products.map((product) => (
                <div class="carousel-item">
                  <ProductCard product={product} />
                </div>
              ))}
            </div>
          </div>
          {products.length > 12 && (
            <p class="carousel-more">
              <button type="button" class="btn btn-outline carousel-more-btn">Xem thêm sản phẩm</button>
            </p>
          )}
        </>
      ) : (
        <p class="empty">Nhóm này đang được cập nhật sản phẩm. Mời bạn quay lại sau hoặc nhắn Zalo để được tư vấn.</p>
      )
    }
  </ShopShell>
</BaseLayout>

<script>
  import { initProductLoadMoreGrids } from '../../../lib/product-grid';
  initProductLoadMoreGrids();
</script>
