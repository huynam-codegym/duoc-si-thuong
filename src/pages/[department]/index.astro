---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShopShell from '../../components/ShopShell.astro';
import ProductCard from '../../components/ProductCard.astro';
import ProductNotice from '../../components/ProductNotice.astro';
import { departments, departmentSlugs, type DepartmentSlug } from '../../lib/departments';
import { getProducts } from '../../lib/products';

export function getStaticPaths() {
  return departmentSlugs.map((department) => ({ params: { department } }));
}

const slug = Astro.params.department as DepartmentSlug;
const department = departments[slug];
const products = await getProducts(slug);
---

<BaseLayout title={department.name} description={department.description}>
  <ShopShell department={slug}>
    <section class="hero shop-hero">
      <h1>{department.name}</h1>
      <p>{department.description} Bấm vào sản phẩm để xem chi tiết và đặt hàng.</p>
    </section>
    <ProductNotice department={slug} short />

    {
      products.length > 0 ? (
        <>
          <div class="carousel carousel-wide">
            <div class="carousel-track">
              {products.map((product) => (
                <div class="carousel-item">
                  <ProductCard product={product} />
                </div>
              ))}
            </div>
          </div>
          {products.length > 12 && (
            <p class="carousel-more">
              <button type="button" class="btn btn-outline carousel-more-btn">Xem thêm sản phẩm</button>
            </p>
          )}
        </>
      ) : (
        <p class="empty">Sản phẩm đang được cập nhật. Mời bạn quay lại sau hoặc nhắn Zalo để được tư vấn.</p>
      )
    }
  </ShopShell>
</BaseLayout>

<script>
  import { initProductLoadMoreGrids } from '../../lib/product-grid';
  initProductLoadMoreGrids();
</script>
