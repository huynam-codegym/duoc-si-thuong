---
import { render } from 'astro:content';
import { getImage } from 'astro:assets';
import logo from '../../assets/logo.jpg';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShopShell from '../../components/ShopShell.astro';
import ProductNotice from '../../components/ProductNotice.astro';
import Disclaimer from '../../components/Disclaimer.astro';
import { departments } from '../../lib/departments';
import { originFlagCode } from '../../lib/flags';
import { foldVietnamese, formatDate } from '../../lib/posts';
import { formatPrice, getProducts, priceBucket } from '../../lib/products';
import { site } from '../../lib/site';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const products = await getProducts();
  return products.map((product) => ({
    params: { department: product.data.department, slug: product.id },
    props: { product },
  }));
}

const { product } = Astro.props;
const {
  name,
  summary,
  department: departmentSlug,
  group,
  price,
  unit,
  brand,
  origin,
  dosageForm,
  ingredients,
  image,
  imageAlt,
  gallery,
  video,
  videoThumbnail,
  publicationNo,
  adConfirmationNo,
  updatedAt,
  draft,
} = product.data;
const { Content, headings } = await render(product);
// Mục lục bên trái phần mô tả: các tiêu đề cấp 2 trong nội dung sản phẩm
const sections = headings.filter((heading) => heading.depth === 2);
const department = departments[departmentSlug];
const groupInfo = department.groups[group];
const flagCode = originFlagCode(origin);
const cartImage = await getImage({ src: image, width: 160, height: 160, format: 'webp' });
const imageForSchema = await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg' });

// Ảnh chính + ảnh phụ (nếu có): mỗi ảnh cần bản hiển thị (vuông, vừa khung) và bản lớn hơn để phóng to khi rê chuột
const galleryImages = [image, ...(gallery ?? [])];
const galleryPhotos = await Promise.all(
  galleryImages.map(async (img) => {
    const display = await getImage({ src: img, width: 700, height: 700, format: 'webp' });
    const zoom = await getImage({ src: img, width: 1300, height: 1300, format: 'webp' });
    return { displaySrc: display.src, zoomSrc: zoom.src, width: display.attributes.width, height: display.attributes.height };
  }),
);

// Ảnh đại diện video (nếu có) — cùng cỡ hiển thị với ảnh thường, hiện làm mục ĐẦU TIÊN trong dải ảnh nhỏ
const videoThumb = videoThumbnail ? await getImage({ src: videoThumbnail, width: 700, height: 700, format: 'webp' }) : null;
// Có video thì mặc định hiện video ngay khi vào trang (thay vì phải bấm mới thấy), ảnh sản phẩm lùi
// thành lựa chọn kế tiếp trong dải ảnh nhỏ.
const hasVideo = Boolean(video && videoThumb);
// Sản phẩm có nhiều ảnh: chỉ hiện sẵn 4 ảnh đầu trong dải ảnh nhỏ (không tính video), ảnh còn lại
// nằm sau nút "Xem thêm N ảnh" — giống kiểu bộ ảnh trên Facebook, tránh dải ảnh nhỏ dài lê thê.
const INLINE_PHOTO_COUNT = 4;
const extraPhotoCount = Math.max(0, galleryPhotos.length - INLINE_PHOTO_COUNT);
// Logo + tên thương hiệu đè lên góc trên-trái khi đang xem video (chủ website yêu cầu tháng 9/2026,
// vì video gửi lên chưa có sẵn logo). Đây là lớp phủ trên trang, KHÔNG chỉnh sửa vào file video gốc
// (máy chạy Claude chưa cài công cụ dựng/ghép video) — đổi video khác thì logo vẫn tự hiện, không
// phải làm lại. Ẩn/hiện tự động theo video đang ẩn hay hiện, xem CSS `.gallery-video-watermark`.
const watermarkLogo = hasVideo ? await getImage({ src: logo, width: 80, height: 80, format: 'webp' }) : null;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name,
  description: summary,
  inLanguage: 'vi',
  image: new URL(imageForSchema.src, Astro.site).href,
  ...(brand && { brand: { '@type': 'Brand', name: brand } }),
};
---

<BaseLayout title={name} description={summary} jsonLd={jsonLd} image={image} noindex={draft}>
  <ShopShell department={departmentSlug} current={group}>
    <article class="product" data-pagefind-body>
      <!-- Không hiện trên trang, chỉ để Pagefind lọc kết quả tìm kiếm theo khu/nhóm/giá (xem /tim-kiem/) -->
      <span hidden data-pagefind-filter="Loại nội dung">Sản phẩm</span>
      <span hidden data-pagefind-filter="Khu">{department.name}</span>
      <span hidden data-pagefind-filter="Nhóm">{groupInfo.name}</span>
      {priceBucket(price) && <span hidden data-pagefind-filter="Giá">{priceBucket(price)}</span>}
      <!-- Cho phép trang /tim-kiem/ sắp xếp theo giá (thấp→cao/cao→thấp). Đệm số 0 phía trước vì Pagefind
           so sánh giá trị sắp xếp như CHUỖI KÝ TỰ, không phải số — không đệm thì "9000" > "80000" (sai). -->
      {price !== undefined && <span hidden data-pagefind-sort={`Gia:${String(price).padStart(9, '0')}`} />}
      {
        draft && (
          <p class="draft-banner">
            Bản nháp: sản phẩm này chưa được đăng nên sẽ không xuất hiện trên website chính thức.
          </p>
        )
      }
      <nav class="breadcrumb" aria-label="Đường dẫn">
        <a href={url('/')}>Trang chủ</a> /
        <a href={url(`/${departmentSlug}/`)}>{department.name}</a> /
        <a href={url(`/${departmentSlug}/nhom/${group}/`)}>{groupInfo.name}</a> /
        <span aria-current="page">{name}</span>
      </nav>

      <div class="product-top">
        <div class="product-gallery">
          <div class="product-gallery-stage">
            <div class="product-gallery-main" id="galleryMain" data-zoom={galleryPhotos[0].zoomSrc}>
              <img id="galleryMainImg" src={galleryPhotos[0].displaySrc} alt={imageAlt} width={galleryPhotos[0].width} height={galleryPhotos[0].height} loading="eager" hidden={hasVideo} />
              {
                hasVideo && (
                  <video id="galleryMainVideo" class="gallery-main-video" controls playsinline preload="none" poster={videoThumb!.src}>
                    <source src={url(video!)} />
                    Trình duyệt của bạn không hỗ trợ phát video này.
                  </video>
                )
              }
              {
                hasVideo && watermarkLogo && (
                  <div class="gallery-video-watermark" aria-hidden="true">
                    <img src={watermarkLogo.src} alt="" />
                    <span>Dược Sĩ Thương</span>
                  </div>
                )
              }
              <div class="gallery-lens" id="galleryLens" aria-hidden="true"></div>
            </div>
            {
              (galleryPhotos.length > 1 || hasVideo) && (
                <div class="product-gallery-thumbs" role="tablist" aria-label="Các ảnh và video khác của sản phẩm">
                  {hasVideo && (
                    <button
                      type="button"
                      id="galleryVideoThumb"
                      class={`gallery-thumb gallery-thumb-video${hasVideo ? ' active' : ''}`}
                      role="tab"
                      aria-selected="true"
                      aria-label={`Xem video ngắn về ${name}`}
                    >
                      <img src={videoThumb!.src} alt="" />
                      <span class="gallery-thumb-play" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="18" height="18">
                          <path d="M8 5.5v13l11-6.5z" fill="currentColor" />
                        </svg>
                      </span>
                    </button>
                  )}
                  {galleryPhotos.map((photo, index) => {
                    const isExtra = index >= INLINE_PHOTO_COUNT;
                    return (
                      <button
                        type="button"
                        class={`gallery-thumb${index === 0 && !hasVideo ? ' active' : ''}${isExtra ? ' gallery-thumb-extra' : ''}`}
                        data-display={photo.displaySrc}
                        data-zoom={photo.zoomSrc}
                        role="tab"
                        aria-selected={index === 0 && !hasVideo ? 'true' : 'false'}
                        aria-label={`Xem ảnh ${index + 1}`}
                        hidden={isExtra}
                      >
                        <img src={photo.displaySrc} alt="" />
                      </button>
                    );
                  })}
                  {extraPhotoCount > 0 && (
                    <button type="button" id="galleryMoreBtn" class="gallery-thumb gallery-thumb-more" aria-label={`Xem thêm ${extraPhotoCount} ảnh`}>
                      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="4" width="18" height="15" rx="2" />
                        <circle cx="8.5" cy="9.5" r="1.5" fill="currentColor" stroke="none" />
                        <path d="M21 15l-5.5-5.5a1.5 1.5 0 0 0-2.1 0L4 19" />
                      </svg>
                      <span>
                        Xem thêm
                        <br />
                        {extraPhotoCount} ảnh
                      </span>
                    </button>
                  )}
                </div>
              )
            }
          </div>
          <div class="product-gallery-zoom" id="galleryZoom" aria-hidden="true"></div>
        </div>
        <div class="product-info">
          <p class="origin-brand-row">
            <span class="origin-line">
              {flagCode && <img class="origin-flag" src={url(`/flags/${flagCode}.svg`)} alt="" width="16" height="12" loading="lazy" />}
              {origin}
            </span>
            {brand && (
              <span class="brand-line">
                Thương hiệu: <strong class="origin-brand-name" title={brand}>{brand}</strong>
              </span>
            )}
          </p>
          <a class="tag" href={url(`/${departmentSlug}/nhom/${group}/`)}>{groupInfo.name}</a>
          <h1>{name}</h1>
          <p class="lead">{summary}</p>
          <p class="product-price product-price-lg">
            {formatPrice(price)}
            {unit && <span class="product-unit"> / {unit}</span>}
          </p>
          <dl class="product-facts">
            {dosageForm && (<><dt>Dạng bào chế</dt><dd>{dosageForm}</dd></>)}
            {ingredients && (<><dt>Thành phần</dt><dd>{ingredients}</dd></>)}
            {publicationNo && (<><dt>Số công bố sản phẩm</dt><dd>{publicationNo}</dd></>)}
            {adConfirmationNo && (<><dt>Xác nhận quảng cáo</dt><dd>{adConfirmationNo}</dd></>)}
          </dl>
          <div class="buy-qty">
            <span id="qty-label">Số lượng</span>
            <div class="qty" role="group" aria-labelledby="qty-label">
              <button type="button" class="qty-btn" data-qty-step="-1" aria-label="Giảm số lượng">−</button>
              <input id="buy-qty" type="number" min="1" max="20" value="1" inputmode="numeric" aria-labelledby="qty-label" />
              <button type="button" class="qty-btn" data-qty-step="1" aria-label="Tăng số lượng">+</button>
            </div>
          </div>
          <div class="actions">
            <button
              type="button"
              class="btn"
              data-add-to-cart
              data-qty-input="#buy-qty"
              data-go-cart
              data-cart-url={url('/gio-hang/')}
              data-id={product.id}
              data-name={name}
              data-price={price ?? ''}
              data-unit={unit ?? ''}
              data-image={cartImage.src}
            >
              Mua ngay
            </button>
            <button
              type="button"
              class="btn btn-outline"
              data-add-to-cart
              data-qty-input="#buy-qty"
              data-id={product.id}
              data-name={name}
              data-price={price ?? ''}
              data-unit={unit ?? ''}
              data-image={cartImage.src}
            >
              Thêm vào giỏ
            </button>
            <a class="btn btn-outline" href={site.zaloHref} target="_blank" rel="noopener noreferrer">Hỏi qua Zalo</a>
          </div>
        </div>
      </div>

      <ProductNotice department={departmentSlug} />

      <section class="product-detail">
        {
          sections.length > 1 && (
            <nav class="detail-nav" aria-label="Mục lục thông tin sản phẩm">
              <ul>
                {sections.map((section) => (
                  <li>
                    <a href={`#${section.slug}`}>{section.text}</a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }
        <div class="detail-body">
          <div class="font-toggle" role="group" aria-label="Kích thước chữ">
            <span>Kích thước chữ</span>
            <button type="button" data-font="normal" aria-pressed="true">Mặc định</button>
            <button type="button" data-font="large" aria-pressed="false">Lớn hơn</button>
          </div>
          <div class="prose product-desc">
            <Content />
          </div>
        </div>
      </section>

      <p class="product-seller">
        Sản phẩm được giới thiệu và bán bởi {site.pharmacy.name} (do dược sĩ Thương điều hành). Thông tin sản phẩm cập
        nhật ngày {formatDate(updatedAt)}.
      </p>
      <div class="article-end">
        <Disclaimer />
      </div>

      <!-- Bản không dấu của tên và mô tả, chỉ để tìm kiếm không dấu (xem foldVietnamese) -->
      <p hidden aria-hidden="true">{foldVietnamese(`${name}. ${summary}`)}</p>
    </article>
  </ShopShell>
</BaseLayout>

<script>
  // Ảnh sản phẩm: bấm ảnh nhỏ để đổi ảnh chính; rê chuột lên ảnh chính để phóng to sang khung bên cạnh
  // (chỉ áp dụng khi có chuột thật, không hiện trên điện thoại/máy tính bảng vì không có "rê chuột").
  const galleryMain = document.getElementById('galleryMain');
  const galleryMainImg = document.getElementById('galleryMainImg') as HTMLImageElement | null;
  const galleryMainVideo = document.getElementById('galleryMainVideo') as HTMLVideoElement | null;
  const galleryVideoThumb = document.getElementById('galleryVideoThumb') as HTMLButtonElement | null;
  const galleryZoom = document.getElementById('galleryZoom');
  const galleryLens = document.getElementById('galleryLens') as HTMLElement | null;
  // Khớp với `background-size: 220%` của .product-gallery-zoom trong global.css: khung kính lúp
  // (vùng đang được phóng to) chiếm 1 / 2.2 chiều rộng/cao ảnh chính. Đổi số này thì đổi luôn CSS.
  const ZOOM_FACTOR = 2.2;

  // Ảnh và video (nếu có) dùng CHUNG một khung hiển thị chính, đổi qua lại bằng cách ẩn/hiện —
  // không phải mở tab mới. Chỉ chọn <button> đổi ảnh (KHÔNG gồm nút video và nút "Xem thêm", xử lý
  // riêng bên dưới). querySelectorAll lấy CẢ các nút ảnh đang ẩn (.gallery-thumb-extra, thuộc tính
  // hidden không loại chúng khỏi kết quả) nên bấm "Xem thêm" xong vẫn đổi ảnh được luôn, không cần
  // gắn lại sự kiện.
  const photoThumbs = document.querySelectorAll<HTMLButtonElement>('button.gallery-thumb:not(.gallery-thumb-video):not(.gallery-thumb-more)');
  const galleryMoreBtn = document.getElementById('galleryMoreBtn') as HTMLButtonElement | null;
  galleryMoreBtn?.addEventListener('click', () => {
    document.querySelectorAll<HTMLButtonElement>('.gallery-thumb-extra').forEach((t) => (t.hidden = false));
    galleryMoreBtn.hidden = true;
  });

  function setActiveThumb(thumb: HTMLButtonElement) {
    photoThumbs.forEach((t) => {
      t.classList.toggle('active', t === thumb);
      t.setAttribute('aria-selected', String(t === thumb));
    });
    galleryVideoThumb?.classList.toggle('active', false);
    galleryVideoThumb?.setAttribute('aria-selected', 'false');
  }

  photoThumbs.forEach((thumb) => {
    thumb.addEventListener('click', () => {
      // Đang phát video mà đổi sang ảnh thì dừng video lại trước, không để chạy ngầm không thấy
      if (galleryMainVideo && !galleryMainVideo.hidden) {
        galleryMainVideo.pause();
        galleryMainVideo.hidden = true;
      }
      if (galleryMainImg) {
        galleryMainImg.hidden = false;
        galleryMainImg.src = thumb.dataset.display ?? '';
      }
      galleryMain?.setAttribute('data-zoom', thumb.dataset.zoom ?? '');
      setActiveThumb(thumb);
    });
  });

  galleryVideoThumb?.addEventListener('click', () => {
    if (!galleryMainVideo || !galleryMainImg) return;
    galleryMainImg.hidden = true;
    galleryMainVideo.hidden = false;
    photoThumbs.forEach((t) => {
      t.classList.remove('active');
      t.setAttribute('aria-selected', 'false');
    });
    galleryVideoThumb.classList.add('active');
    galleryVideoThumb.setAttribute('aria-selected', 'true');
  });

  // Kính lúp chỉ áp dụng khi đang xem ẢNH — không có ý nghĩa với video, và data-zoom lúc đó vẫn giữ
  // ảnh cũ nên rê chuột lên video sẽ đè một lớp ảnh phóng to sai lên trên nếu không chặn lại.
  if (galleryMain && galleryZoom && galleryLens && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
    galleryMain.addEventListener('mouseenter', () => {
      if (galleryMainImg?.hidden) return;
      galleryZoom.style.backgroundImage = `url(${galleryMain.getAttribute('data-zoom')})`;
      galleryZoom.classList.add('active');
      galleryLens.classList.add('active');
    });
    galleryMain.addEventListener('mousemove', (event) => {
      const rect = galleryMain.getBoundingClientRect();
      const mouseEvent = event as MouseEvent;
      const lensW = rect.width / ZOOM_FACTOR;
      const lensH = rect.height / ZOOM_FACTOR;
      // Tâm khung kính lúp đi theo chuột, nhưng không cho tràn ra ngoài ảnh
      let x = mouseEvent.clientX - rect.left - lensW / 2;
      let y = mouseEvent.clientY - rect.top - lensH / 2;
      x = Math.max(0, Math.min(x, rect.width - lensW));
      y = Math.max(0, Math.min(y, rect.height - lensH));
      galleryLens.style.width = `${lensW}px`;
      galleryLens.style.height = `${lensH}px`;
      galleryLens.style.left = `${x}px`;
      galleryLens.style.top = `${y}px`;
      const bgX = (x / (rect.width - lensW)) * 100;
      const bgY = (y / (rect.height - lensH)) * 100;
      galleryZoom.style.backgroundPosition = `${bgX}% ${bgY}%`;
    });
    galleryMain.addEventListener('mouseleave', () => {
      galleryZoom.classList.remove('active');
      galleryLens.classList.remove('active');
    });
  }

  // Chọn số lượng trước khi mua
  const input = document.getElementById('buy-qty') as HTMLInputElement | null;
  const clamp = (value: number) => Math.min(20, Math.max(1, Number.isFinite(value) ? Math.floor(value) : 1));
  document.querySelectorAll<HTMLElement>('[data-qty-step]').forEach((button) => {
    button.addEventListener('click', () => {
      if (input) input.value = String(clamp(Number(input.value) + Number(button.dataset.qtyStep)));
    });
  });
  input?.addEventListener('change', () => (input.value = String(clamp(Number(input.value)))));

  // Đổi cỡ chữ phần mô tả (nhiều người đọc là người lớn tuổi); nhớ lựa chọn trên máy người đọc
  const description = document.querySelector('.product-desc');
  const fontButtons = document.querySelectorAll<HTMLButtonElement>('[data-font]');
  function setFont(mode: string) {
    description?.classList.toggle('prose-large', mode === 'large');
    fontButtons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.font === mode)));
    try {
      localStorage.setItem('duocsithuong-font', mode);
    } catch {
      // trình duyệt chặn lưu trữ: bỏ qua
    }
  }
  fontButtons.forEach((button) => button.addEventListener('click', () => setFont(button.dataset.font ?? 'normal')));
  try {
    if (localStorage.getItem('duocsithuong-font') === 'large') setFont('large');
  } catch {
    // bỏ qua
  }
</script>
