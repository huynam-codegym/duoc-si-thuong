---
import { render } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShopShell from '../../components/ShopShell.astro';
import ProductNotice from '../../components/ProductNotice.astro';
import Disclaimer from '../../components/Disclaimer.astro';
import { departments } from '../../lib/departments';
import { foldVietnamese, formatDate } from '../../lib/posts';
import { formatPrice, getProducts } from '../../lib/products';
import { site } from '../../lib/site';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const products = await getProducts();
  return products.map((product) => ({
    params: { department: product.data.department, slug: product.id },
    props: { product },
  }));
}

const { product } = Astro.props;
const {
  name,
  summary,
  department: departmentSlug,
  group,
  price,
  unit,
  brand,
  origin,
  dosageForm,
  ingredients,
  image,
  imageAlt,
  gallery,
  publicationNo,
  adConfirmationNo,
  updatedAt,
  draft,
} = product.data;
const { Content, headings } = await render(product);
// Mục lục bên trái phần mô tả: các tiêu đề cấp 2 trong nội dung sản phẩm
const sections = headings.filter((heading) => heading.depth === 2);
const department = departments[departmentSlug];
const groupInfo = department.groups[group];
const cartImage = await getImage({ src: image, width: 160, height: 160, format: 'webp' });
const imageForSchema = await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg' });

// Ảnh chính + ảnh phụ (nếu có): mỗi ảnh cần bản hiển thị (vuông, vừa khung) và bản lớn hơn để phóng to khi rê chuột
const galleryImages = [image, ...(gallery ?? [])];
const galleryPhotos = await Promise.all(
  galleryImages.map(async (img) => {
    const display = await getImage({ src: img, width: 700, height: 700, format: 'webp' });
    const zoom = await getImage({ src: img, width: 1300, height: 1300, format: 'webp' });
    return { displaySrc: display.src, zoomSrc: zoom.src, width: display.attributes.width, height: display.attributes.height };
  }),
);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name,
  description: summary,
  inLanguage: 'vi',
  image: new URL(imageForSchema.src, Astro.site).href,
  ...(brand && { brand: { '@type': 'Brand', name: brand } }),
};
---

<BaseLayout title={name} description={summary} jsonLd={jsonLd} image={image} noindex={draft}>
  <ShopShell department={departmentSlug} current={group}>
    <article class="product" data-pagefind-body>
      {
        draft && (
          <p class="draft-banner">
            Bản nháp: sản phẩm này chưa được đăng nên sẽ không xuất hiện trên website chính thức.
          </p>
        )
      }
      <nav class="breadcrumb" aria-label="Đường dẫn">
        <a href={url('/')}>Trang chủ</a> /
        <a href={url(`/${departmentSlug}/`)}>{department.name}</a> /
        <a href={url(`/${departmentSlug}/nhom/${group}/`)}>{groupInfo.name}</a> /
        <span aria-current="page">{name}</span>
      </nav>

      <div class="product-top">
        <div class="product-gallery">
          <div class="product-gallery-stage">
            <div class="product-gallery-main" id="galleryMain" data-zoom={galleryPhotos[0].zoomSrc}>
              <img id="galleryMainImg" src={galleryPhotos[0].displaySrc} alt={imageAlt} width={galleryPhotos[0].width} height={galleryPhotos[0].height} loading="eager" />
            </div>
            {
              galleryPhotos.length > 1 && (
                <div class="product-gallery-thumbs" role="tablist" aria-label="Các ảnh khác của sản phẩm">
                  {galleryPhotos.map((photo, index) => (
                    <button
                      type="button"
                      class={`gallery-thumb${index === 0 ? ' active' : ''}`}
                      data-display={photo.displaySrc}
                      data-zoom={photo.zoomSrc}
                      role="tab"
                      aria-selected={index === 0 ? 'true' : 'false'}
                      aria-label={`Xem ảnh ${index + 1}`}
                    >
                      <img src={photo.displaySrc} alt="" />
                    </button>
                  ))}
                </div>
              )
            }
          </div>
          <div class="product-gallery-zoom" id="galleryZoom" aria-hidden="true"></div>
        </div>
        <div class="product-info">
          <a class="tag" href={url(`/${departmentSlug}/nhom/${group}/`)}>{groupInfo.name}</a>
          <h1>{name}</h1>
          <p class="lead">{summary}</p>
          <p class="product-price product-price-lg">
            {formatPrice(price)}
            {unit && <span class="product-unit"> / {unit}</span>}
          </p>
          <dl class="product-facts">
            {brand && (<><dt>Thương hiệu</dt><dd>{brand}</dd></>)}
            {origin && (<><dt>Xuất xứ</dt><dd>{origin}</dd></>)}
            {dosageForm && (<><dt>Dạng bào chế</dt><dd>{dosageForm}</dd></>)}
            {ingredients && (<><dt>Thành phần</dt><dd>{ingredients}</dd></>)}
            {publicationNo && (<><dt>Số công bố sản phẩm</dt><dd>{publicationNo}</dd></>)}
            {adConfirmationNo && (<><dt>Xác nhận quảng cáo</dt><dd>{adConfirmationNo}</dd></>)}
          </dl>
          <div class="buy-qty">
            <span id="qty-label">Số lượng</span>
            <div class="qty" role="group" aria-labelledby="qty-label">
              <button type="button" class="qty-btn" data-qty-step="-1" aria-label="Giảm số lượng">−</button>
              <input id="buy-qty" type="number" min="1" max="20" value="1" inputmode="numeric" aria-labelledby="qty-label" />
              <button type="button" class="qty-btn" data-qty-step="1" aria-label="Tăng số lượng">+</button>
            </div>
          </div>
          <div class="actions">
            <button
              type="button"
              class="btn"
              data-add-to-cart
              data-qty-input="#buy-qty"
              data-go-cart
              data-cart-url={url('/gio-hang/')}
              data-id={product.id}
              data-name={name}
              data-price={price ?? ''}
              data-unit={unit ?? ''}
              data-image={cartImage.src}
            >
              Mua ngay
            </button>
            <button
              type="button"
              class="btn btn-outline"
              data-add-to-cart
              data-qty-input="#buy-qty"
              data-id={product.id}
              data-name={name}
              data-price={price ?? ''}
              data-unit={unit ?? ''}
              data-image={cartImage.src}
            >
              Thêm vào giỏ
            </button>
            <a class="btn btn-outline" href={site.zaloHref} target="_blank" rel="noopener noreferrer">Hỏi qua Zalo</a>
          </div>
        </div>
      </div>

      <ProductNotice department={departmentSlug} />

      <section class="product-detail">
        {
          sections.length > 1 && (
            <nav class="detail-nav" aria-label="Mục lục thông tin sản phẩm">
              <ul>
                {sections.map((section) => (
                  <li>
                    <a href={`#${section.slug}`}>{section.text}</a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }
        <div class="detail-body">
          <div class="font-toggle" role="group" aria-label="Kích thước chữ">
            <span>Kích thước chữ</span>
            <button type="button" data-font="normal" aria-pressed="true">Mặc định</button>
            <button type="button" data-font="large" aria-pressed="false">Lớn hơn</button>
          </div>
          <div class="prose product-desc">
            <Content />
          </div>
        </div>
      </section>

      <p class="product-seller">
        Sản phẩm được giới thiệu và bán bởi {site.pharmacy.name} (do dược sĩ Thương điều hành). Thông tin sản phẩm cập
        nhật ngày {formatDate(updatedAt)}.
      </p>
      <div class="article-end">
        <Disclaimer />
      </div>

      <!-- Bản không dấu của tên và mô tả, chỉ để tìm kiếm không dấu (xem foldVietnamese) -->
      <p hidden aria-hidden="true">{foldVietnamese(`${name}. ${summary}`)}</p>
    </article>
  </ShopShell>
</BaseLayout>

<script>
  // Ảnh sản phẩm: bấm ảnh nhỏ để đổi ảnh chính; rê chuột lên ảnh chính để phóng to sang khung bên cạnh
  // (chỉ áp dụng khi có chuột thật, không hiện trên điện thoại/máy tính bảng vì không có "rê chuột").
  const galleryMain = document.getElementById('galleryMain');
  const galleryMainImg = document.getElementById('galleryMainImg') as HTMLImageElement | null;
  const galleryZoom = document.getElementById('galleryZoom');

  document.querySelectorAll<HTMLButtonElement>('.gallery-thumb').forEach((thumb) => {
    thumb.addEventListener('click', () => {
      if (galleryMainImg) galleryMainImg.src = thumb.dataset.display ?? '';
      galleryMain?.setAttribute('data-zoom', thumb.dataset.zoom ?? '');
      document.querySelectorAll<HTMLButtonElement>('.gallery-thumb').forEach((t) => {
        const active = t === thumb;
        t.classList.toggle('active', active);
        t.setAttribute('aria-selected', String(active));
      });
    });
  });

  if (galleryMain && galleryZoom && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
    galleryMain.addEventListener('mouseenter', () => {
      galleryZoom.style.backgroundImage = `url(${galleryMain.getAttribute('data-zoom')})`;
      galleryZoom.classList.add('active');
    });
    galleryMain.addEventListener('mousemove', (event) => {
      const rect = galleryMain.getBoundingClientRect();
      const mouseEvent = event as MouseEvent;
      const x = ((mouseEvent.clientX - rect.left) / rect.width) * 100;
      const y = ((mouseEvent.clientY - rect.top) / rect.height) * 100;
      galleryZoom.style.backgroundPosition = `${x}% ${y}%`;
    });
    galleryMain.addEventListener('mouseleave', () => {
      galleryZoom.classList.remove('active');
    });
  }

  // Chọn số lượng trước khi mua
  const input = document.getElementById('buy-qty') as HTMLInputElement | null;
  const clamp = (value: number) => Math.min(20, Math.max(1, Number.isFinite(value) ? Math.floor(value) : 1));
  document.querySelectorAll<HTMLElement>('[data-qty-step]').forEach((button) => {
    button.addEventListener('click', () => {
      if (input) input.value = String(clamp(Number(input.value) + Number(button.dataset.qtyStep)));
    });
  });
  input?.addEventListener('change', () => (input.value = String(clamp(Number(input.value)))));

  // Đổi cỡ chữ phần mô tả (nhiều người đọc là người lớn tuổi); nhớ lựa chọn trên máy người đọc
  const description = document.querySelector('.product-desc');
  const fontButtons = document.querySelectorAll<HTMLButtonElement>('[data-font]');
  function setFont(mode: string) {
    description?.classList.toggle('prose-large', mode === 'large');
    fontButtons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.font === mode)));
    try {
      localStorage.setItem('duocsithuong-font', mode);
    } catch {
      // trình duyệt chặn lưu trữ: bỏ qua
    }
  }
  fontButtons.forEach((button) => button.addEventListener('click', () => setFont(button.dataset.font ?? 'normal')));
  try {
    if (localStorage.getItem('duocsithuong-font') === 'large') setFont('large');
  } catch {
    // bỏ qua
  }
</script>
