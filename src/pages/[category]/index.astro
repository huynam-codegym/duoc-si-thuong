---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { categories, categorySlugs, type CategorySlug } from '../../lib/categories';
import { getPosts } from '../../lib/posts';

export function getStaticPaths() {
  return categorySlugs.map((category) => ({ params: { category } }));
}

const category = Astro.params.category as CategorySlug;
const { name, description } = categories[category];
const posts = await getPosts(category);
---

<BaseLayout title={name} description={description}>
  <div class="container">
    <section class="hero">
      <h1>{name}</h1>
      <p>{description}</p>
    </section>

    {
      posts.length > 0 ? (
        <div class="grid">
          {posts.map((post) => <PostCard post={post} />)}
        </div>
      ) : (
        <p class="empty">Chuyên mục này chưa có bài viết được kiểm duyệt. Mời bạn quay lại sau.</p>
      )
    }
  </div>
</BaseLayout>
