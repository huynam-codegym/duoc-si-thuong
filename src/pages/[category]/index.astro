---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { categories, categorySlugs, getGroups, type CategorySlug } from '../../lib/categories';
import { getPosts } from '../../lib/posts';
import { url } from '../../lib/url';

export function getStaticPaths() {
  return categorySlugs.map((category) => ({ params: { category } }));
}

const category = Astro.params.category as CategorySlug;
const { name, description } = categories[category];
const groups = getGroups(category);
const posts = await getPosts(category);
---

<BaseLayout title={name} description={description}>
  <div class="container">
    <section class="hero">
      <h1>{name}</h1>
      <p>{description}</p>
    </section>

    {
      groups.length > 0 && (
        <section aria-labelledby="nhom">
          <h2 class="section-title" id="nhom">
            Chọn theo nhóm
          </h2>
          <div class="grid">
            {groups.map(([groupSlug, group]) => (
              <a class="card" href={url(`/${category}/nhom/${groupSlug}/`)}>
                <h3>{group.name}</h3>
                <p>{group.description}</p>
              </a>
            ))}
          </div>
          <h2 class="section-title">Tất cả bài viết</h2>
        </section>
      )
    }

    {
      posts.length > 0 ? (
        <div class="grid">
          {posts.map((post) => <PostCard post={post} />)}
        </div>
      ) : (
        <p class="empty">Chuyên mục này chưa có bài viết được kiểm duyệt. Mời bạn quay lại sau.</p>
      )
    }
  </div>
</BaseLayout>
