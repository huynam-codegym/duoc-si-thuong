---
import { render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Disclaimer from '../../components/Disclaimer.astro';
import { categories } from '../../lib/categories';
import { foldVietnamese, formatDate, getPosts, isPublishable } from '../../lib/posts';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { category: post.data.category, slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { title, description, category, publishedAt, updatedAt, sources, reviewedBy, cover, coverAlt, coverCredit } = post.data;
const { Content } = await render(post);
const { subcategory } = post.data;
const group = subcategory ? categories[category].groups?.[subcategory] : undefined;
const coverForSchema = cover ? await getImage({ src: cover, width: 1200, height: 630, fit: 'cover', format: 'jpg' }) : undefined;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MedicalWebPage',
  headline: title,
  description,
  inLanguage: 'vi',
  datePublished: publishedAt.toISOString(),
  dateModified: updatedAt.toISOString(),
  ...(coverForSchema && { image: new URL(coverForSchema.src, Astro.site).href }),
  ...(reviewedBy.trim() && { reviewedBy: { '@type': 'Person', name: reviewedBy } }),
};
---

<BaseLayout title={title} description={description} jsonLd={jsonLd} image={cover}>
  <article class="container narrow article" data-pagefind-body>
    <header>
      {
        !isPublishable(post) && (
          <p class="draft-banner">
            Bản nháp: bài này chưa được dược sĩ/bác sĩ kiểm duyệt nên sẽ không xuất hiện trên website chính thức.
          </p>
        )
      }
      <a class="tag" href={url(`/${category}/`)}>{categories[category].name}</a>
      {
        group && (
          <a class="tag tag-group" href={url(`/${category}/nhom/${subcategory}/`)}>
            {group.name}
          </a>
        )
      }
      <h1>{title}</h1>
      <p class="lead">{description}</p>
      <p class="meta">
        Đăng ngày {formatDate(publishedAt)} · Cập nhật {formatDate(updatedAt)}
        {reviewedBy.trim() && <> · Kiểm duyệt bởi {reviewedBy}</>}
      </p>
    </header>

    {
      cover && (
        <figure class="cover">
          <Image
            src={cover}
            alt={coverAlt ?? ''}
            widths={[640, 1024, 1400]}
            sizes="(min-width: 46rem) 46rem, 100vw"
            quality={85}
            loading="eager"
          />
          {coverCredit && <figcaption>{coverCredit}</figcaption>}
        </figure>
      )
    }

    <div class="prose">
      <Content />
    </div>

    <section class="sources" aria-labelledby="nguon">
      <h2 id="nguon">Nguồn tham khảo</h2>
      <ol>
        {
          sources.map((source) => (
            <li>
              <a href={source.url} rel="noopener noreferrer" target="_blank">
                {source.title}
              </a>
            </li>
          ))
        }
      </ol>
    </section>

    <div class="article-end">
      <Disclaimer />
    </div>

    <!-- Bản không dấu của tiêu đề và mô tả, chỉ để tìm kiếm không dấu (xem foldVietnamese) -->
    <p hidden aria-hidden="true">{foldVietnamese(`${title}. ${description}`)}</p>
  </article>
</BaseLayout>
