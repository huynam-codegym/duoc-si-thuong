---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { url } from '../../lib/url';

// Trang quản trị tin nhắn (tháng 10/2026) — CHỈ chủ website (tài khoản có profiles.is_admin = true)
// mới xem được, kiểm tra ở script bên dưới (không phải kiểm tra phía máy chủ vì site tĩnh không có
// máy chủ — an toàn thật sự nằm ở RLS của bảng conversations/messages trong Supabase, trang này chỉ
// là giao diện, dù có bỏ qua được bước kiểm tra UI thì vẫn không đọc được dữ liệu người khác).
---

<BaseLayout title="Quản lý tin nhắn" description="Trang quản trị tin nhắn khách hàng." noindex>
  <div class="container">
    <section class="hero shop-hero">
      <h1>Quản lý tin nhắn</h1>
    </section>

    <p id="adminLoading">Đang kiểm tra đăng nhập...</p>

    <div id="adminDenied" class="order" hidden>
      <p id="adminDeniedText"></p>
      <a class="btn" href={url('/')}>Về trang chủ</a>
    </div>

    <div id="adminInbox" class="admin-inbox" hidden>
      <aside class="admin-inbox-list" id="adminConvList" aria-label="Danh sách hội thoại"></aside>
      <section class="admin-inbox-thread">
        <p id="adminThreadEmpty" class="empty">Chọn 1 hội thoại bên trái để xem và trả lời.</p>
        <div id="adminThreadBox" hidden>
          <div class="admin-thread-head">
            <strong id="adminThreadName"></strong>
          </div>
          <div class="admin-thread-messages" id="adminThreadMessages"></div>
          <div class="admin-thread-compose">
            <form class="admin-thread-form" id="adminThreadForm">
              <label class="visually-hidden" for="adminThreadFile">Đính kèm ảnh hoặc file (chọn được nhiều cùng lúc)</label>
              <input id="adminThreadFile" type="file" accept="image/*,.pdf,.doc,.docx,.txt" multiple hidden />
              <button type="button" class="admin-thread-icon-btn" id="adminAttachBtn" aria-label="Đính kèm ảnh hoặc file">
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
                  <path d="M8 12.5l6.4-6.4a3 3 0 1 1 4.25 4.24L9.88 19.1a5 5 0 1 1-7.07-7.07L11.5 3.4" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </button>
              <button type="button" class="admin-thread-icon-btn" id="adminMicBtn" aria-label="Ghi âm tin nhắn thoại">
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
                  <rect x="9" y="3" width="6" height="11" rx="3" fill="none" stroke="currentColor" stroke-width="1.7"></rect>
                  <path d="M5 11a7 7 0 0 0 14 0M12 18v3" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path>
                </svg>
              </button>
              <div class="admin-thread-input-box" id="adminThreadInputBox">
                <div class="admin-thread-attach-list" id="adminAttachList" hidden></div>
                <label class="visually-hidden" for="adminThreadInput">Nhập trả lời</label>
                <input id="adminThreadInput" type="text" placeholder="Nhập câu trả lời..." autocomplete="off" />
              </div>
              <button type="submit" class="btn">Gửi</button>
            </form>
          </div>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<script>
  import { supabase } from '../../lib/supabase';
  import {
    isCurrentUserAdmin,
    listConversationsForAdmin,
    listMessages,
    sendMessage,
    subscribeToInbox,
    uploadAttachment,
    getAttachmentUrl,
    markReadByAdmin,
    type ChatMessage,
    type Conversation,
    type AttachmentType,
  } from '../../lib/chat';

  const loading = document.getElementById('adminLoading')!;
  const denied = document.getElementById('adminDenied')!;
  const deniedText = document.getElementById('adminDeniedText')!;
  const inbox = document.getElementById('adminInbox')!;
  const convList = document.getElementById('adminConvList')!;
  const threadEmpty = document.getElementById('adminThreadEmpty')!;
  const threadBox = document.getElementById('adminThreadBox')!;
  const threadName = document.getElementById('adminThreadName')!;
  const threadMessages = document.getElementById('adminThreadMessages')!;
  const threadForm = document.getElementById('adminThreadForm') as HTMLFormElement;
  const threadInput = document.getElementById('adminThreadInput') as HTMLInputElement;
  const fileInput = document.getElementById('adminThreadFile') as HTMLInputElement;
  const attachBtn = document.getElementById('adminAttachBtn')!;
  const micBtn = document.getElementById('adminMicBtn')!;
  const attachList = document.getElementById('adminAttachList')!;

  let conversations: Conversation[] = [];
  let unreadCounts: Record<string, number> = {};
  let activeId: string | null = null;

  function formatTime(iso: string): string {
    return new Date(iso).toLocaleString('vi-VN', { day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' });
  }

  // Đếm tin KHÁCH gửi còn chưa xem cho mỗi hội thoại — chấm xanh + đậm chữ trong danh sách bên trái
  // để biết ngay hội thoại nào cần mở ra trả lời, không phải bấm từng cái mới biết.
  async function loadUnreadCounts() {
    const { data, error } = await supabase.from('messages').select('conversation_id').eq('sender', 'customer').is('read_at', null);
    if (error) return;
    const counts: Record<string, number> = {};
    (data ?? []).forEach((row: { conversation_id: string }) => {
      counts[row.conversation_id] = (counts[row.conversation_id] ?? 0) + 1;
    });
    unreadCounts = counts;
  }

  function renderConvList() {
    convList.innerHTML = '';
    conversations.forEach((c) => {
      const item = document.createElement('button');
      item.type = 'button';
      const unread = unreadCounts[c.id] ?? 0;
      item.className = 'admin-conv-item' + (c.id === activeId ? ' active' : '') + (unread > 0 ? ' has-unread' : '');
      const name = document.createElement('strong');
      name.textContent = c.customer_name || `Khách #${c.id.slice(0, 8)}`;
      if (unread > 0) {
        const dot = document.createElement('span');
        dot.className = 'admin-conv-unread-dot';
        dot.textContent = String(unread);
        name.append(dot);
      }
      const time = document.createElement('span');
      time.textContent = formatTime(c.last_message_at);
      item.append(name, time);
      item.addEventListener('click', () => openConversation(c.id));
      convList.append(item);
    });
  }

  function appendAttachment(bubble: HTMLElement, type: AttachmentType, name: string | null, url: string) {
    if (type === 'image') {
      const img = document.createElement('img');
      img.src = url;
      img.alt = name || 'Ảnh đính kèm';
      img.className = 'admin-thread-attachment-image';
      img.loading = 'lazy';
      img.addEventListener('click', () => window.open(url, '_blank'));
      bubble.append(img);
    } else if (type === 'audio') {
      const audio = document.createElement('audio');
      audio.controls = true;
      audio.src = url;
      audio.className = 'admin-thread-attachment-audio';
      bubble.append(audio);
    } else {
      const link = document.createElement('a');
      link.href = url;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.className = 'admin-thread-attachment-file';
      link.textContent = '📎 ' + (name || 'Tệp đính kèm');
      bubble.append(link);
    }
  }

  // "from" ở đây là 'admin' (tin của chính mình, hiện Đã gửi/Đã xem) hoặc 'customer'.
  const statusEls = new Map<string, HTMLElement>();
  async function renderBubble(message: Partial<ChatMessage> & { body: string; sender: 'customer' | 'admin' }, overrideUrl?: string) {
    const bubble = document.createElement('div');
    bubble.className = `admin-thread-bubble admin-thread-bubble-${message.sender}`;
    if (message.id) bubble.dataset.id = message.id;

    if (message.body) {
      const p = document.createElement('p');
      p.className = 'admin-thread-bubble-text';
      p.textContent = message.body;
      bubble.append(p);
    }
    if (message.attachment_type) {
      const url = overrideUrl ?? (message.attachment_url ? await getAttachmentUrl(message.attachment_url) : null);
      if (url) appendAttachment(bubble, message.attachment_type, message.attachment_name ?? null, url);
    }
    if (message.sender === 'admin') {
      const status = document.createElement('span');
      status.className = 'admin-thread-status';
      status.textContent = message.read_at ? 'Đã xem' : 'Đã gửi';
      bubble.append(status);
      if (message.id) statusEls.set(message.id, status);
    }

    threadMessages.append(bubble);
    threadMessages.scrollTop = threadMessages.scrollHeight;
  }

  async function openConversation(id: string) {
    activeId = id;
    renderConvList();
    threadEmpty.hidden = true;
    threadBox.hidden = false;
    statusEls.clear();
    const conv = conversations.find((c) => c.id === id);
    threadName.textContent = conv?.customer_name || `Khách #${id.slice(0, 8)}`;
    threadMessages.innerHTML = '';
    const history = await listMessages(id);
    for (const m of history) await renderBubble(m);
    await markReadByAdmin(id);
    delete unreadCounts[id];
    renderConvList();
    window.setTimeout(() => threadInput.focus(), 50);
  }

  async function refreshConversations() {
    conversations = await listConversationsForAdmin();
    await loadUnreadCounts();
    renderConvList();
  }

  const MAX_ATTACHMENT_BYTES = 15 * 1024 * 1024;

  async function sendReply(text: string, file?: File, kind?: AttachmentType) {
    if (!activeId) return;
    if (!text && !file) return;
    let attachment;
    let objectUrl: string | undefined;
    if (file && kind) {
      if (file.size > MAX_ATTACHMENT_BYTES) {
        window.alert('File quá lớn (tối đa 15MB), chọn file nhỏ hơn nhé.');
        return;
      }
      objectUrl = URL.createObjectURL(file);
      try {
        attachment = await uploadAttachment(activeId, file, kind);
      } catch {
        window.alert('Gửi file chưa thành công, thử lại nhé.');
        return;
      }
    }
    try {
      await sendMessage(activeId, 'admin', text, undefined, attachment);
      // Không tự renderBubble ở đây — subscribeToInbox() bên dưới sẽ nhận lại đúng tin nhắn này qua
      // realtime (của chính mình gửi) và hiện ra, tránh hiện trùng 2 lần. Ảnh/file thì dùng objectUrl
      // vừa tạo để khi bubble đó tới qua realtime, hiển thị ngay không cần chờ signed URL — nhưng vì
      // không tự render ở đây nên objectUrl chỉ cần giữ sống tới khi realtime echo quay về (trình
      // duyệt tự dọn khi tải lại trang).
    } catch {
      threadInput.value = text;
    }
  }

  threadForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    const text = threadInput.value.trim();
    threadInput.value = '';
    if (selectedFiles.length > 0) {
      const files = selectedFiles;
      selectedFiles = [];
      renderAttachList();
      // Chữ gõ kèm chỉ gắn vào file ĐẦU TIÊN (mỗi dòng tin nhắn chỉ gắn được 1 đính kèm) — gửi tuần
      // tự để giữ đúng thứ tự hiện ra.
      for (let i = 0; i < files.length; i++) {
        const file = files[i];
        const kind: AttachmentType = file.type.startsWith('image/') ? 'image' : 'file';
        await sendReply(i === 0 ? text : '', file, kind);
      }
      return;
    }
    if (!text) return;
    await sendReply(text);
  });

  // ---- Đính kèm ảnh/file — chọn được NHIỀU cùng lúc (tháng 10/2026). Ảnh hiện xem trước bằng ảnh
  // thu nhỏ thật (giống Messenger), file khác hiện tên file trong 1 ô chữ, mỗi ô có nút ✕ riêng.
  const MAX_FILES_PER_BATCH = 10;
  let selectedFiles: File[] = [];

  function renderAttachList() {
    attachList.innerHTML = '';
    attachList.hidden = selectedFiles.length === 0;
    selectedFiles.forEach((file, idx) => {
      if (file.type.startsWith('image/')) {
        const thumb = document.createElement('div');
        thumb.className = 'admin-thread-attach-thumb';
        const img = document.createElement('img');
        img.src = URL.createObjectURL(file);
        img.alt = 'Ảnh đính kèm';
        const removeBtn = document.createElement('button');
        removeBtn.type = 'button';
        removeBtn.setAttribute('aria-label', 'Bỏ đính kèm');
        removeBtn.textContent = '✕';
        removeBtn.addEventListener('click', () => {
          selectedFiles.splice(idx, 1);
          renderAttachList();
        });
        thumb.append(img, removeBtn);
        attachList.append(thumb);
      } else {
        const chip = document.createElement('div');
        chip.className = 'admin-thread-attach-chip';
        const name = document.createElement('span');
        name.textContent = file.name;
        const removeBtn = document.createElement('button');
        removeBtn.type = 'button';
        removeBtn.setAttribute('aria-label', 'Bỏ đính kèm');
        removeBtn.textContent = '✕';
        removeBtn.addEventListener('click', () => {
          selectedFiles.splice(idx, 1);
          renderAttachList();
        });
        chip.append(name, removeBtn);
        attachList.append(chip);
      }
    });
  }

  attachBtn.addEventListener('click', () => fileInput.click());
  fileInput.addEventListener('change', () => {
    const picked = Array.from(fileInput.files ?? []);
    fileInput.value = '';
    for (const file of picked) {
      if (selectedFiles.length >= MAX_FILES_PER_BATCH) {
        window.alert(`Chỉ gửi được tối đa ${MAX_FILES_PER_BATCH} ảnh/file mỗi lần.`);
        break;
      }
      if (file.size > MAX_ATTACHMENT_BYTES) {
        window.alert(`File "${file.name}" quá lớn (tối đa 15MB), đã bỏ qua.`);
        continue;
      }
      selectedFiles.push(file);
    }
    renderAttachList();
  });

  // ---- Ghi âm tin nhắn thoại ----
  let mediaRecorder: MediaRecorder | null = null;
  let recordedChunks: BlobPart[] = [];
  let recordingStream: MediaStream | null = null;

  async function toggleRecording() {
    if (mediaRecorder && mediaRecorder.state === 'recording') {
      mediaRecorder.stop();
      return;
    }
    try {
      recordingStream = await navigator.mediaDevices.getUserMedia({ audio: true });
    } catch {
      window.alert('Không truy cập được micro.');
      return;
    }
    const candidates = ['audio/webm;codecs=opus', 'audio/webm', 'audio/ogg'];
    const mimeType = candidates.find((t) => (window as any).MediaRecorder?.isTypeSupported?.(t));
    mediaRecorder = new MediaRecorder(recordingStream, mimeType ? { mimeType } : undefined);
    recordedChunks = [];
    mediaRecorder.addEventListener('dataavailable', (e) => {
      if (e.data.size > 0) recordedChunks.push(e.data);
    });
    mediaRecorder.addEventListener('stop', async () => {
      recordingStream?.getTracks().forEach((t) => t.stop());
      micBtn.classList.remove('is-recording');
      if (recordedChunks.length === 0) return;
      const blob = new Blob(recordedChunks, { type: mediaRecorder?.mimeType || 'audio/webm' });
      const ext = (blob.type.split('/')[1] || 'webm').split(';')[0];
      const file = new File([blob], `tin-nhan-thoai.${ext}`, { type: blob.type });
      await sendReply('', file, 'audio');
    });
    mediaRecorder.start();
    micBtn.classList.add('is-recording');
  }
  micBtn.addEventListener('click', toggleRecording);

  async function init() {
    const {
      data: { session },
    } = await supabase.auth.getSession();
    if (!session) {
      loading.hidden = true;
      deniedText.textContent = 'Bạn cần đăng nhập đúng tài khoản quản trị để xem trang này — bấm "Đăng nhập" ở đầu trang.';
      denied.hidden = false;
      return;
    }
    const isAdmin = await isCurrentUserAdmin();
    if (!isAdmin) {
      loading.hidden = true;
      deniedText.textContent = 'Tài khoản này không có quyền truy cập trang quản trị.';
      denied.hidden = false;
      return;
    }
    loading.hidden = true;
    inbox.hidden = false;
    await refreshConversations();

    subscribeToInbox(
      () => {
        refreshConversations();
      },
      async (message) => {
        if (message.conversation_id === activeId) {
          await renderBubble(message);
          if (message.sender === 'customer') await markReadByAdmin(activeId);
        }
        refreshConversations();
      },
      (message) => {
        const status = statusEls.get(message.id);
        if (status) status.textContent = message.read_at ? 'Đã xem' : 'Đã gửi';
      },
    );
  }

  init();
</script>
