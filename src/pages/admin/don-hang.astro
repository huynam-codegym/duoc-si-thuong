---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { url } from '../../lib/url';

// Trang quản lý đơn hàng (tháng 10/2026) — CHỈ chủ website (profiles.is_admin = true) xem được. Kiểm tra
// quyền ở script chỉ là lớp giao diện; an toàn thật nằm ở RLS của bảng orders ("Admin xem mọi đơn hàng")
// và hàm admin_update_order_status() — xem mục "9." trong docs/supabase-schema.sql. Mọi đơn (kể cả khách
// chưa đăng nhập) do Edge Function send-order-email lưu vào bảng orders lúc khách bấm "Hoàn tất".
---

<BaseLayout title="Quản lý đơn hàng" description="Trang quản trị đơn hàng." noindex>
  <div class="container">
    <section class="hero shop-hero">
      <h1>Quản lý đơn hàng</h1>
    </section>

    <p id="adminLoading">Đang kiểm tra đăng nhập...</p>

    <div id="adminDenied" class="order" hidden>
      <p id="adminDeniedText"></p>
      <a class="btn" href={url('/')}>Về trang chủ</a>
    </div>

    <div id="ordersWrap" hidden>
      <div class="admin-orders-toolbar">
        <div class="reviews-filter" id="statusFilter" role="group" aria-label="Lọc theo trạng thái"></div>
        <div class="admin-orders-search">
          <input type="search" id="orderSearch" placeholder="Tìm mã đơn, tên, số điện thoại..." aria-label="Tìm đơn hàng" />
          <button type="button" class="btn btn-outline" id="reloadOrders">Tải lại</button>
        </div>
      </div>
      <p class="admin-orders-note">
        Giá và thành tiền được máy chủ tính lại theo bảng giá trên website lúc khách đặt. Đổi trạng thái đơn sẽ tự gửi
        email báo khách (nếu khách để email). Tin Zalo tự động chỉ gửi 1 lần lúc khách đặt; muốn báo thêm qua Zalo thì
        bấm "Nhắn Zalo cho khách".
      </p>
      <button type="button" class="admin-orders-new" id="newOrdersBanner" hidden></button>
      <p class="review-form-msg" id="ordersError" hidden></p>
      <ul class="admin-orders-list" id="ordersList" aria-live="polite"></ul>
      <p class="empty" id="ordersEmpty" hidden>Không có đơn hàng nào.</p>
    </div>
  </div>
</BaseLayout>

<script>
  import { supabase } from '../../lib/supabase';
  import { isCurrentUserAdmin } from '../../lib/chat';
  import { site } from '../../lib/site';

  interface OrderItem {
    id: string;
    name: string;
    qty: number;
    price: number | null;
  }
  interface Order {
    id: string;
    order_code: string | null;
    created_at: string;
    status: string;
    customer_name: string;
    phone: string;
    address: string;
    note: string | null;
    payment_method: string;
    items: OrderItem[];
    total: number | null;
    shipping: number | null;
    orderer_name: string | null;
    orderer_phone: string | null;
    orderer_email: string | null;
    hide_product_name: boolean;
    user_id: string | null;
  }

  const STATUSES: { key: string; label: string }[] = [
    { key: 'moi', label: 'Mới đặt' },
    { key: 'da_xac_nhan', label: 'Đã xác nhận' },
    { key: 'dang_giao', label: 'Đang giao' },
    { key: 'hoan_tat', label: 'Hoàn tất' },
    { key: 'huy', label: 'Đã hủy' },
  ];
  const STATUS_LABEL = Object.fromEntries(STATUSES.map((s) => [s.key, s.label]));
  const PAYMENT_LABEL: Record<string, string> = {
    cod: 'Tiền mặt khi nhận hàng',
    bank: 'Chuyển khoản (QR Code)',
    momo: 'Ví MoMo',
    zalopay: 'Ví ZaloPay',
    visa: 'Thẻ Visa/Mastercard',
  };

  const loading = document.getElementById('adminLoading')!;
  const denied = document.getElementById('adminDenied')!;
  const deniedText = document.getElementById('adminDeniedText')!;
  const wrap = document.getElementById('ordersWrap')!;
  const filterEl = document.getElementById('statusFilter')!;
  const searchEl = document.getElementById('orderSearch') as HTMLInputElement;
  const reloadBtn = document.getElementById('reloadOrders') as HTMLButtonElement;
  const listEl = document.getElementById('ordersList')!;
  const emptyEl = document.getElementById('ordersEmpty') as HTMLElement;
  const errorEl = document.getElementById('ordersError') as HTMLElement;

  let orders: Order[] = [];
  // Mặc định xem đơn "Mới đặt" — việc cần xử lý trước tiên.
  let activeStatus = 'moi';

  // Dựng phần tử bằng textContent (KHÔNG innerHTML) vì tên/địa chỉ/ghi chú là chữ khách tự gõ.
  function el<K extends keyof HTMLElementTagNameMap>(tag: K, className?: string, text?: string): HTMLElementTagNameMap[K] {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text !== undefined) node.textContent = text;
    return node;
  }

  // Dòng báo kết quả gửi email/chép lời nhắn nằm TRÊN danh sách, vì đổi trạng thái xong đơn thường rời
  // khỏi bộ lọc đang xem (ví dụ "Mới đặt") nên báo ngay trong thẻ đơn sẽ biến mất cùng thẻ.
  const noticeEl = el('p', 'admin-order-notice');
  noticeEl.setAttribute('role', 'status');
  noticeEl.hidden = true;
  listEl.before(noticeEl);

  function showNotice(text: string, ok: boolean) {
    noticeEl.textContent = text;
    noticeEl.classList.toggle('is-error', !ok);
    noticeEl.hidden = false;
  }

  const ZALO_STATUS_TEXT: Record<string, string> = {
    moi: 'đã được nhà thuốc ghi nhận',
    da_xac_nhan: 'đã được xác nhận, nhà thuốc đang chuẩn bị hàng',
    dang_giao: 'đang được giao, bạn giữ điện thoại để người giao hàng liên hệ nhé',
    hoan_tat: 'đã giao thành công. Cảm ơn bạn đã tin tưởng Dược Sĩ Thương',
    huy: 'đã được hủy. Nếu bạn đã chuyển khoản, nhà thuốc sẽ liên hệ hoàn tiền',
  };

  function zaloMessage(order: Order): string {
    const code = order.order_code ?? '';
    const name = order.orderer_name || order.customer_name;
    return `Dược Sĩ Thương xin chào ${name}. Đơn hàng #${code} ${ZALO_STATUS_TEXT[order.status] ?? ''}. Xem tình trạng đơn: https://duocsithuong.com/tra-cuu-don-hang/?ma=${encodeURIComponent(code)}`;
  }

  // Gửi email báo trạng thái mới cho khách (Edge Function notify-order-status tự kiểm tra quyền admin và
  // đọc lại đơn từ cơ sở dữ liệu). Trạng thái đã đổi xong rồi, nên email lỗi chỉ báo, không hoàn tác.
  async function notifyCustomer(order: Order) {
    const code = order.order_code ?? '';
    if (order.status === 'moi') {
      showNotice(`Đã cập nhật đơn #${code}.`, true);
      return;
    }
    showNotice(`Đã cập nhật đơn #${code}. Đang báo khách…`, true);
    const { data, error } = await supabase.functions.invoke('notify-order-status', { body: { orderId: order.id } });
    let result = data;
    let emailError = '';
    if (error) {
      emailError = error.message;
      try {
        result = await error.context.json();
        emailError = result?.error ?? emailError;
      } catch {
        // phản hồi không phải JSON: giữ thông báo lỗi gốc
      }
    }
    const parts: string[] = [];
    if (emailError) parts.push(`chưa gửi được email (${emailError})`);
    else if (result?.sent) parts.push('đã gửi email');
    else if (result?.reason === 'no_email') parts.push('khách không để email');
    // Tin Zalo OA tự động chỉ gửi 1 lần lúc đặt đơn (tiết kiệm phí); báo đổi trạng thái qua Zalo thì bấm tay.
    const hint = !result?.sent ? ' Bạn có thể bấm "Nhắn Zalo cho khách".' : '';
    showNotice(`Đã cập nhật đơn #${code}${parts.length ? ': ' + parts.join(', ') : ''}.${hint}`, !emailError);
  }

  function vnd(value: number): string {
    return `${value.toLocaleString('vi-VN')}đ`;
  }

  function formatDate(iso: string): string {
    return new Date(iso).toLocaleString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' });
  }

  function telLink(phone: string): HTMLAnchorElement {
    const a = el('a', undefined, phone);
    a.href = `tel:${phone.replace(/[^\d+]/g, '')}`;
    return a;
  }

  function infoRow(label: string, value: string | Node): HTMLElement {
    const row = el('p', 'admin-order-row');
    row.append(el('span', 'admin-order-label', label));
    row.append(typeof value === 'string' ? document.createTextNode(value) : value);
    return row;
  }

  function renderFilter() {
    filterEl.replaceChildren();
    const tabs = [{ key: 'all', label: 'Tất cả' }, ...STATUSES];
    for (const tab of tabs) {
      const count = tab.key === 'all' ? orders.length : orders.filter((o) => o.status === tab.key).length;
      const btn = el('button', `pill-filter${activeStatus === tab.key ? ' active' : ''}`, `${tab.label} (${count})`);
      btn.type = 'button';
      btn.addEventListener('click', () => {
        activeStatus = tab.key;
        render();
      });
      filterEl.append(btn);
    }
  }

  function orderCard(order: Order): HTMLElement {
    const li = el('li', `admin-order status-${order.status}`);

    const head = el('div', 'admin-order-head');
    head.append(el('strong', 'admin-order-code', order.order_code ? `#${order.order_code}` : 'Đơn (chưa có mã)'));
    head.append(el('span', 'admin-order-time', formatDate(order.created_at)));
    head.append(el('span', `admin-order-status status-${order.status}`, STATUS_LABEL[order.status] ?? order.status));
    li.append(head);

    const people = el('div', 'admin-order-people');
    const orderer = el('div');
    orderer.append(el('p', 'admin-order-subtitle', 'Người đặt'));
    orderer.append(infoRow('Họ tên:', order.orderer_name || order.customer_name));
    if (order.orderer_phone) orderer.append(infoRow('SĐT:', telLink(order.orderer_phone)));
    if (order.orderer_email) orderer.append(infoRow('Email:', order.orderer_email));
    orderer.append(infoRow('Tài khoản:', order.user_id ? 'Đã đăng nhập' : 'Khách vãng lai'));
    const recipient = el('div');
    recipient.append(el('p', 'admin-order-subtitle', 'Người nhận'));
    recipient.append(infoRow('Họ tên:', order.customer_name));
    recipient.append(infoRow('SĐT:', telLink(order.phone)));
    recipient.append(infoRow('Địa chỉ:', order.address));
    people.append(orderer, recipient);
    li.append(people);

    const items = el('ul', 'admin-order-items');
    for (const item of order.items ?? []) {
      const row = el('li');
      row.append(el('span', undefined, `${item.name} × ${item.qty}`));
      row.append(el('span', undefined, item.price != null ? vnd(item.price * item.qty) : 'Liên hệ'));
      items.append(row);
    }
    li.append(items);

    const totals = el('div', 'admin-order-totals');
    if (order.total != null) totals.append(infoRow('Tiền sản phẩm:', vnd(order.total)));
    totals.append(infoRow('Phí vận chuyển:', order.shipping == null ? 'Nhà thuốc báo sau' : order.shipping === 0 ? 'Miễn phí' : vnd(order.shipping)));
    if (order.total != null) {
      const grand = el('strong', undefined, vnd(order.total + (order.shipping ?? 0)));
      totals.append(infoRow('Thành tiền:', grand));
    }
    totals.append(infoRow('Thanh toán:', PAYMENT_LABEL[order.payment_method] ?? order.payment_method));
    li.append(totals);

    if (order.note) li.append(infoRow('Ghi chú:', order.note));
    if (order.hide_product_name) li.append(el('p', 'admin-order-warn', 'Khách yêu cầu ẨN TÊN SẢN PHẨM khi giao hàng.'));

    const actions = el('div', 'admin-order-actions');
    const select = el('select');
    select.setAttribute('aria-label', 'Đổi trạng thái đơn');
    for (const s of STATUSES) {
      const opt = el('option', undefined, s.label);
      opt.value = s.key;
      opt.selected = s.key === order.status;
      select.append(opt);
    }
    const saveBtn = el('button', 'btn', 'Cập nhật trạng thái');
    saveBtn.type = 'button';
    const msg = el('p', 'review-form-msg');
    msg.hidden = true;
    saveBtn.addEventListener('click', async () => {
      if (select.value === order.status) return;
      saveBtn.disabled = true;
      msg.hidden = true;
      const { error } = await supabase.rpc('admin_update_order_status', { p_order_id: order.id, p_status: select.value });
      saveBtn.disabled = false;
      if (error) {
        msg.textContent = `Chưa cập nhật được: ${error.message}`;
        msg.hidden = false;
        return;
      }
      order.status = select.value;
      render();
      notifyCustomer(order);
    });
    // Zalo không cho điền sẵn nội dung qua đường dẫn, nên chép sẵn lời nhắn vào bộ nhớ tạm rồi mở
    // đúng cuộc trò chuyện với khách, dược sĩ chỉ cần dán và gửi.
    const zaloPhone = (order.orderer_phone || order.phone).replace(/\D/g, '');
    const zaloBtn = el('a', 'btn btn-outline', 'Nhắn Zalo cho khách');
    zaloBtn.href = `https://zalo.me/${zaloPhone}`;
    zaloBtn.target = '_blank';
    zaloBtn.rel = 'noopener noreferrer';
    zaloBtn.addEventListener('click', () => {
      navigator.clipboard
        ?.writeText(zaloMessage(order))
        .then(() => showNotice(`Đã chép lời nhắn cho đơn #${order.order_code ?? ''}. Dán vào Zalo rồi gửi cho khách.`, true))
        .catch(() => showNotice('Chưa chép được lời nhắn, hãy gõ tay trong Zalo.', false));
    });
    const printBtn = el('button', 'btn btn-outline', 'In phiếu giao hàng');
    printBtn.type = 'button';
    printBtn.addEventListener('click', () => printSlip(order));
    actions.append(select, saveBtn, zaloBtn, printBtn);
    li.append(actions, msg);
    return li;
  }

  // Phiếu giao hàng: dựng 1 khối #printSlip ngay dưới <body>, CSS @media print chỉ in đúng khối này
  // (body.print-slip ẩn mọi phần tử khác). Khách yêu cầu "ẩn tên sản phẩm" thì phiếu KHÔNG ghi tên sản
  // phẩm, vì phiếu dán ngoài kiện hàng, người giao và người xung quanh đều đọc được.
  function printSlip(order: Order) {
    document.getElementById('printSlip')?.remove();
    const slip = el('div', 'print-slip');
    slip.id = 'printSlip';

    const head = el('div', 'print-slip-head');
    head.append(el('strong', undefined, site.name));
    head.append(el('span', undefined, `${site.pharmacy.name} · ĐT/Zalo: ${site.phone}`));
    slip.append(head);

    slip.append(el('p', 'print-slip-code', order.order_code ? `Mã đơn: #${order.order_code}` : 'Mã đơn: (chưa có)'));
    slip.append(el('p', 'print-slip-date', `Ngày đặt: ${formatDate(order.created_at)}`));

    const to = el('div', 'print-slip-to');
    to.append(el('p', 'print-slip-label', 'NGƯỜI NHẬN'));
    to.append(el('p', 'print-slip-name', order.customer_name));
    to.append(el('p', undefined, `SĐT: ${order.phone}`));
    to.append(el('p', undefined, `Địa chỉ: ${order.address}`));
    slip.append(to);

    const goods = el('div', 'print-slip-goods');
    goods.append(el('p', 'print-slip-label', 'HÀNG HÓA'));
    const qty = (order.items ?? []).reduce((sum, i) => sum + i.qty, 0);
    if (order.hide_product_name) {
      goods.append(el('p', undefined, `Hàng chăm sóc sức khỏe — ${qty} sản phẩm (ẩn tên theo yêu cầu của khách)`));
    } else {
      const ul = el('ul');
      for (const item of order.items ?? []) ul.append(el('li', undefined, `${item.name} × ${item.qty}`));
      goods.append(ul);
    }
    slip.append(goods);

    const money = el('div', 'print-slip-money');
    const grand = order.total != null ? order.total + (order.shipping ?? 0) : null;
    if (order.payment_method === 'cod') {
      money.append(el('p', 'print-slip-cod', grand != null ? `THU HỘ (COD): ${vnd(grand)}` : 'THU HỘ (COD): nhà thuốc báo sau'));
    } else {
      money.append(el('p', undefined, `Thanh toán: ${PAYMENT_LABEL[order.payment_method] ?? order.payment_method} — kiểm tra đã nhận tiền trước khi giao.`));
    }
    slip.append(money);

    if (order.note) slip.append(el('p', 'print-slip-note', `Ghi chú: ${order.note}`));
    slip.append(el('p', 'print-slip-foot', 'Vui lòng gọi cho người nhận trước khi giao. Cảm ơn bạn!'));

    document.body.append(slip);
    document.body.classList.add('print-slip-mode');
    const cleanup = () => {
      document.body.classList.remove('print-slip-mode');
      slip.remove();
      window.removeEventListener('afterprint', cleanup);
    };
    window.addEventListener('afterprint', cleanup);
    window.print();
  }

  // Báo đơn mới: cứ 30 giây hỏi lại các đơn tạo SAU đơn mới nhất đang có. Dùng hỏi định kỳ (polling)
  // thay vì Supabase Realtime vì realtime cần bật thêm publication cho bảng orders; 30 giây là đủ nhanh
  // cho việc xử lý đơn và mỗi lần hỏi rất nhẹ (chỉ lấy đơn mới).
  const POLL_MS = 30_000;
  const baseTitle = document.title;
  const newBanner = document.getElementById('newOrdersBanner') as HTMLButtonElement;
  let unseenNew = 0;

  function showNewBanner() {
    newBanner.hidden = unseenNew === 0;
    newBanner.textContent = `🔔 Có ${unseenNew} đơn mới vừa đến — bấm để xem`;
    document.title = unseenNew > 0 ? `(${unseenNew}) ${baseTitle}` : baseTitle;
  }

  newBanner.addEventListener('click', () => {
    unseenNew = 0;
    activeStatus = 'moi';
    showNewBanner();
    render();
    listEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  async function pollNewOrders() {
    const latest = orders[0]?.created_at;
    let query = supabase.from('orders').select('*').order('created_at', { ascending: false });
    if (latest) query = query.gt('created_at', latest);
    const { data, error } = await query;
    if (error || !data || data.length === 0) return;
    const known = new Set(orders.map((o) => o.id));
    const fresh = (data as Order[]).filter((o) => !known.has(o.id));
    if (fresh.length === 0) return;
    orders = [...fresh, ...orders];
    unseenNew += fresh.length;
    showNewBanner();
    render();
  }

  function matchesSearch(order: Order, term: string): boolean {
    if (!term) return true;
    const haystack = [order.order_code, order.customer_name, order.orderer_name, order.phone, order.orderer_phone, order.orderer_email]
      .filter(Boolean)
      .join(' ')
      .toLowerCase();
    return haystack.includes(term);
  }

  function render() {
    renderFilter();
    const term = searchEl.value.trim().toLowerCase();
    const visible = orders.filter((o) => (activeStatus === 'all' || o.status === activeStatus) && matchesSearch(o, term));
    listEl.replaceChildren(...visible.map(orderCard));
    emptyEl.hidden = visible.length > 0;
  }

  async function loadOrders() {
    errorEl.hidden = true;
    reloadBtn.disabled = true;
    const { data, error } = await supabase.from('orders').select('*').order('created_at', { ascending: false });
    reloadBtn.disabled = false;
    if (error) {
      errorEl.textContent = `Không tải được đơn hàng: ${error.message}`;
      errorEl.hidden = false;
      return;
    }
    orders = (data ?? []) as Order[];
    unseenNew = 0;
    showNewBanner();
    render();
  }

  searchEl.addEventListener('input', render);
  reloadBtn.addEventListener('click', loadOrders);

  async function init() {
    const {
      data: { session },
    } = await supabase.auth.getSession();
    if (!session) {
      loading.hidden = true;
      deniedText.textContent = 'Bạn cần đăng nhập đúng tài khoản quản trị để xem trang này — bấm "Đăng nhập" ở đầu trang.';
      denied.hidden = false;
      return;
    }
    if (!(await isCurrentUserAdmin())) {
      loading.hidden = true;
      deniedText.textContent = 'Tài khoản này không có quyền truy cập trang quản trị.';
      denied.hidden = false;
      return;
    }
    loading.hidden = true;
    wrap.hidden = false;
    await loadOrders();
    setInterval(pollNewOrders, POLL_MS);
  }

  init();
</script>
