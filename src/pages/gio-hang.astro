---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductNotice from '../components/ProductNotice.astro';
import { site } from '../lib/site';
import { url } from '../lib/url';
---

<BaseLayout title="Giỏ hàng" description="Giỏ hàng và đặt hàng thực phẩm chức năng từ Nhà Thuốc Nhật Minh." noindex>
  <div class="container">
    <section class="hero shop-hero">
      <h1>Giỏ hàng</h1>
    </section>

    <noscript><p class="empty">Giỏ hàng cần bật JavaScript. Bạn có thể nhắn Zalo cho nhà thuốc để đặt hàng.</p></noscript>

    <div id="cart-empty" class="empty" hidden>
      <p>Giỏ hàng của bạn đang trống.</p>
      <a class="btn" href={url('/thuc-pham-chuc-nang/')}>Xem sản phẩm</a>
    </div>

    <div id="cart-filled" class="cart-layout" hidden>
      <section aria-labelledby="cart-items-title">
        <h2 id="cart-items-title" class="visually-hidden">Sản phẩm trong giỏ</h2>
        <ul id="cart-list" class="cart-list"></ul>
        <div class="cart-total">
          <span>Tạm tính</span>
          <strong id="cart-total">0 ₫</strong>
        </div>
        <p id="cart-unpriced" class="cart-note" hidden>
          Sản phẩm ghi "Liên hệ" chưa được tính vào tạm tính. Nhà thuốc sẽ báo giá khi xác nhận đơn.
        </p>
        <p class="cart-note">Giá chưa gồm phí giao hàng. Nhà thuốc sẽ xác nhận lại giá, phí giao và cách thanh toán trước khi giao.</p>
        <ProductNotice short />
      </section>

      <section class="order" id="dat-hang" aria-labelledby="dat-hang-tieu-de">
        <h2 id="dat-hang-tieu-de">Thông tin nhận hàng</h2>
        <form id="order-form" data-endpoint={site.orderEndpoint} data-zalo={site.zaloHref} novalidate>
          <label>
            Họ và tên
            <input type="text" name="name" autocomplete="name" required maxlength="80" />
          </label>
          <label>
            Số điện thoại
            <input type="tel" name="phone" autocomplete="tel" inputmode="tel" required pattern="(0|[+]84)[0-9]{9}" title="Số điện thoại 10 chữ số, ví dụ 0912345678" placeholder="Ví dụ: 0912345678" />
          </label>
          <label>
            Địa chỉ nhận hàng
            <input type="text" name="address" autocomplete="street-address" required maxlength="200" />
          </label>
          <label>
            Ghi chú (không bắt buộc)
            <textarea name="note" rows="3" maxlength="500"></textarea>
          </label>
          <!-- Ô chống thư rác: người thật không thấy và không điền -->
          <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="order-trap" aria-hidden="true" />

          <label class="order-consent">
            <input type="checkbox" name="consent" required />
            <span>
              Tôi đồng ý để nhà thuốc dùng thông tin trên để liên hệ và giao hàng. Không gửi số CCCD, mật khẩu hay
              thông tin thẻ ngân hàng qua form này.
            </span>
          </label>

          <button type="submit" class="btn">Gửi đơn đặt hàng</button>
          <p class="order-error" role="alert" hidden></p>
        </form>
      </section>
    </div>

    <div class="order-result cart-done" id="order-result" role="status" hidden></div>
  </div>

  <script>
    import { MAX_QTY, cartTotal, clearCart, formatVnd, getCart, hasUnpriced, removeItem, setQty, type CartItem } from '../lib/cart';

    const emptyBox = document.getElementById('cart-empty')!;
    const filledBox = document.getElementById('cart-filled')!;
    const list = document.getElementById('cart-list')!;
    const totalEl = document.getElementById('cart-total')!;
    const unpricedEl = document.getElementById('cart-unpriced')!;
    const form = document.getElementById('order-form') as HTMLFormElement;
    const result = document.getElementById('order-result')!;
    const error = form.querySelector<HTMLElement>('.order-error')!;

    function el<K extends keyof HTMLElementTagNameMap>(tag: K, className?: string, text?: string) {
      const node = document.createElement(tag);
      if (className) node.className = className;
      if (text !== undefined) node.textContent = text;
      return node;
    }

    function stepButton(label: string, action: string, id: string, text: string) {
      const button = el('button', 'qty-btn', text);
      button.type = 'button';
      button.setAttribute('aria-label', label);
      button.dataset.action = action;
      button.dataset.id = id;
      return button;
    }

    function row(item: CartItem) {
      const li = el('li', 'cart-item');
      if (item.image) {
        const img = el('img', 'cart-thumb');
        img.src = item.image;
        img.alt = '';
        img.width = 80;
        img.height = 80;
        li.append(img);
      }
      const info = el('div', 'cart-info');
      info.append(el('p', 'cart-name', item.name));
      if (item.unit) info.append(el('p', 'cart-unit', item.unit));
      info.append(el('p', 'cart-price', item.price === null ? 'Liên hệ' : formatVnd(item.price)));

      const qty = el('div', 'qty');
      const input = el('input');
      input.type = 'number';
      input.min = '1';
      input.max = String(MAX_QTY);
      input.value = String(item.qty);
      input.dataset.id = item.id;
      input.setAttribute('aria-label', `Số lượng ${item.name}`);
      qty.append(stepButton(`Giảm số lượng ${item.name}`, 'dec', item.id, '−'), input, stepButton(`Tăng số lượng ${item.name}`, 'inc', item.id, '+'));

      const remove = el('button', 'cart-remove', 'Xóa');
      remove.type = 'button';
      remove.dataset.action = 'remove';
      remove.dataset.id = item.id;
      remove.setAttribute('aria-label', `Xóa ${item.name} khỏi giỏ`);

      const actions = el('div', 'cart-actions');
      actions.append(qty, remove);
      li.append(info, actions);
      return li;
    }

    function render() {
      const items = getCart();
      emptyBox.hidden = items.length > 0 || !result.hidden;
      filledBox.hidden = items.length === 0 || !result.hidden;
      list.replaceChildren(...items.map(row));
      // Giỏ chỉ có sản phẩm chưa có giá thì hiện "Liên hệ" thay vì "0 ₫"
      const total = cartTotal(items);
      totalEl.textContent = total === 0 && hasUnpriced(items) ? 'Liên hệ' : formatVnd(total);
      unpricedEl.hidden = !hasUnpriced(items);
    }

    list.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button[data-action]');
      if (!button?.dataset.id) return;
      const id = button.dataset.id;
      const current = getCart().find((item) => item.id === id);
      if (!current) return;
      if (button.dataset.action === 'remove') removeItem(id);
      if (button.dataset.action === 'inc') setQty(id, current.qty + 1);
      if (button.dataset.action === 'dec') setQty(id, current.qty - 1);
    });
    list.addEventListener('change', (event) => {
      const input = event.target as HTMLInputElement;
      if (input.dataset.id) setQty(input.dataset.id, Number(input.value));
    });
    window.addEventListener('cart:change', render);
    window.addEventListener('storage', render);
    render();

    function showResult(nodes: Node[]) {
      result.replaceChildren(...nodes);
      result.hidden = false;
      filledBox.hidden = true;
      emptyBox.hidden = true;
      result.scrollIntoView({ block: 'start' });
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      error.hidden = true;
      if (!form.reportValidity()) return;
      const data = new FormData(form);
      if (data.get('_gotcha')) return; // thư rác

      const items = getCart();
      if (items.length === 0) return;
      const total = cartTotal(items);
      const order = {
        items: items.map((item) => ({ id: item.id, name: item.name, qty: item.qty, price: item.price })),
        total,
        name: String(data.get('name')).trim(),
        phone: String(data.get('phone')).trim(),
        address: String(data.get('address')).trim(),
        note: String(data.get('note') ?? '').trim(),
        page: location.href,
      };
      const lines = items.map((item, index) => {
        const price = item.price === null ? 'Liên hệ' : `${formatVnd(item.price)} = ${formatVnd(item.price * item.qty)}`;
        return `${index + 1}. ${item.name} x${item.qty} - ${price}`;
      });
      const text = [
        'ĐẶT HÀNG',
        ...lines,
        `Tạm tính: ${formatVnd(total)}${hasUnpriced(items) ? ' (chưa gồm sản phẩm liên hệ giá)' : ''}`,
        `Họ tên: ${order.name}`,
        `Số điện thoại: ${order.phone}`,
        `Địa chỉ: ${order.address}`,
        order.note && `Ghi chú: ${order.note}`,
      ]
        .filter(Boolean)
        .join('\n');

      const endpoint = form.dataset.endpoint;
      if (endpoint) {
        try {
          const response = await fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify(order),
          });
          if (!response.ok) throw new Error(String(response.status));
          clearCart();
          showResult([el('p', undefined, 'Đã gửi đơn. Nhà thuốc sẽ liên hệ với bạn qua số điện thoại đã để lại để xác nhận. Cảm ơn bạn!')]);
        } catch {
          error.textContent = 'Chưa gửi được đơn. Bạn vui lòng thử lại hoặc nhắn Zalo cho nhà thuốc.';
          error.hidden = false;
        }
        return;
      }

      // Chưa có địa chỉ nhận đơn: mở Zalo (mở ngay trong lúc bấm nút để trình duyệt không chặn) và chép sẵn nội dung đơn
      window.open(form.dataset.zalo, '_blank', 'noopener');
      navigator.clipboard?.writeText(text).catch(() => {});
      const done = el('button', 'btn', 'Tôi đã gửi xong, xóa giỏ hàng');
      done.type = 'button';
      done.addEventListener('click', () => {
        clearCart();
        location.reload();
      });
      const back = el('button', 'btn btn-outline', 'Quay lại giỏ hàng');
      back.type = 'button';
      back.addEventListener('click', () => {
        result.hidden = true;
        render();
      });
      const actions = el('div', 'actions');
      actions.append(done, back);
      showResult([
        el('p', undefined, 'Đơn của bạn đã được soạn sẵn. Hãy dán nội dung dưới đây vào khung chat Zalo của nhà thuốc rồi bấm gửi:'),
        el('pre', undefined, text),
        actions,
      ]);
    });
  </script>
</BaseLayout>
