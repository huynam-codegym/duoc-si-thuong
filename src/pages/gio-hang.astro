---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../lib/site';
import { url } from '../lib/url';
---

<BaseLayout title="Giỏ hàng" description="Giỏ hàng và đặt hàng sản phẩm từ Nhà Thuốc Nhật Minh." noindex>
  <div class="container">
    <section class="hero shop-hero">
      <h1>Giỏ hàng</h1>
    </section>

    <noscript><p class="empty">Giỏ hàng cần bật JavaScript. Bạn có thể nhắn Zalo cho nhà thuốc để đặt hàng.</p></noscript>

    <div id="cart-empty" class="empty" hidden>
      <p>Giỏ hàng của bạn đang trống.</p>
      <a class="btn" href={url('/')}>Xem sản phẩm</a>
    </div>

    <form id="order-form" class="checkout-layout" data-zalo={site.zaloHref} novalidate hidden>
      <div class="checkout-main">
        <section aria-labelledby="cart-items-title">
          <h2 id="cart-items-title">Danh sách sản phẩm</h2>
          <ul id="cart-list" class="cart-list"></ul>
        </section>

        <section class="order" aria-labelledby="orderer-title">
          <h2 id="orderer-title">Thông tin người đặt</h2>
          <div class="order-grid-2">
            <label>
              Họ và tên người đặt
              <input type="text" name="orderer_name" autocomplete="name" required maxlength="80" data-error-required="Vui lòng nhập họ và tên người đặt." />
              <span class="field-error" data-for="orderer_name" role="alert"></span>
            </label>
            <label>
              Số điện thoại
              <input
                type="tel"
                name="orderer_phone"
                autocomplete="tel"
                inputmode="tel"
                required
                pattern="(0|[+]84)[0-9]{9}"
                placeholder="Ví dụ: 0912345678"
                data-error-required="Vui lòng nhập số điện thoại người đặt."
                data-error-pattern="Số điện thoại chưa đúng, ví dụ 0912345678."
              />
              <span class="field-error" data-for="orderer_phone" role="alert"></span>
            </label>
          </div>
          <label>
            Email (không bắt buộc)
            <input type="email" name="orderer_email" autocomplete="email" maxlength="120" data-error-type="Email chưa đúng định dạng." />
            <span class="field-error" data-for="orderer_email" role="alert"></span>
          </label>
        </section>

        <section class="order" aria-labelledby="recipient-title">
          <h2 id="recipient-title">Thông tin nhận hàng</h2>
          <div class="order-grid-2">
            <label>
              Họ và tên người nhận
              <input type="text" name="recipient_name" autocomplete="name" required maxlength="80" data-error-required="Vui lòng nhập họ và tên người nhận." />
              <span class="field-error" data-for="recipient_name" role="alert"></span>
            </label>
            <label>
              Số điện thoại
              <input
                type="tel"
                name="recipient_phone"
                autocomplete="tel"
                inputmode="tel"
                required
                pattern="(0|[+]84)[0-9]{9}"
                placeholder="Ví dụ: 0912345678"
                data-error-required="Vui lòng nhập số điện thoại người nhận."
                data-error-pattern="Số điện thoại chưa đúng, ví dụ 0912345678."
              />
              <span class="field-error" data-for="recipient_phone" role="alert"></span>
            </label>
          </div>
          <label>
            Địa chỉ nhận hàng
            <input type="text" name="address" autocomplete="street-address" required maxlength="200" data-error-required="Vui lòng nhập địa chỉ nhận hàng." />
            <span class="field-error" data-for="address" role="alert"></span>
          </label>
          <label>
            Ghi chú (không bắt buộc)
            <textarea name="note" rows="3" maxlength="500" placeholder="Ví dụ: Hãy gọi cho tôi 15 phút trước khi giao"></textarea>
          </label>
          <label class="order-radio order-hide-name">
            <input type="checkbox" name="hide_product_name" />
            Ẩn tên sản phẩm khi giao hàng (nhà thuốc sẽ ghi chung chung trên bao bì)
          </label>
        </section>

        <section class="order" aria-labelledby="payment-title">
          <h2 id="payment-title">Chọn phương thức thanh toán</h2>
          <fieldset class="payment-list">
            <legend class="visually-hidden">Hình thức thanh toán</legend>
            <label class="payment-option">
              <input type="radio" name="payment_method" value="cod" checked />
              <span class="payment-icon payment-icon-cod" aria-hidden="true">đ</span>
              <span>Thanh toán tiền mặt khi nhận hàng</span>
            </label>
            <label class="payment-option">
              <input type="radio" name="payment_method" value="bank" />
              <span class="payment-icon payment-icon-bank" aria-hidden="true">QR</span>
              <span>Thanh toán bằng chuyển khoản (QR Code)</span>
            </label>
            <label class="payment-option">
              <input type="radio" name="payment_method" value="momo" />
              <span class="payment-icon payment-icon-momo" aria-hidden="true">M</span>
              <span>Thanh toán bằng ví MoMo</span>
            </label>
            <label class="payment-option">
              <input type="radio" name="payment_method" value="zalopay" />
              <span class="payment-icon payment-icon-zalopay" aria-hidden="true">Z</span>
              <span>Thanh toán bằng ví ZaloPay</span>
            </label>
            <label class="payment-option">
              <input type="radio" name="payment_method" value="visa" />
              <span class="payment-icon payment-icon-visa" aria-hidden="true">V</span>
              <span>Thanh toán bằng thẻ quốc tế (Visa, Master...)</span>
            </label>
          </fieldset>
          <p class="order-lead">Với hình thức khác tiền mặt, nhà thuốc sẽ liên hệ hướng dẫn thanh toán cụ thể trước khi giao hàng. Site chưa thu tiền trực tiếp qua thẻ/ví trên trang.</p>
        </section>

        <!-- Ô chống thư rác: người thật không thấy và không điền -->
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="order-trap" aria-hidden="true" />

        <label class="order-consent">
          <input type="checkbox" name="consent" required data-error-required="Vui lòng đồng ý để nhà thuốc liên hệ và giao hàng trước khi gửi đơn." />
          <span>
            Tôi đồng ý để nhà thuốc dùng thông tin trên để liên hệ và giao hàng. Không gửi số CCCD, mật khẩu hay
            thông tin thẻ ngân hàng qua form này.
          </span>
          <span class="field-error" data-for="consent" role="alert"></span>
        </label>
      </div>

      <aside class="checkout-summary" aria-labelledby="checkout-summary-title">
        <h2 id="checkout-summary-title" class="visually-hidden">Tổng cộng</h2>
        <div class="checkout-summary-lines">
          <div class="checkout-summary-line">
            <span>Tổng tiền</span>
            <span id="cart-original-total">0đ</span>
          </div>
          <div class="checkout-summary-line" id="cart-discount-row" hidden>
            <span>Giảm giá trực tiếp</span>
            <span class="checkout-summary-discount" id="cart-discount">-0đ</span>
          </div>
          <div class="checkout-summary-line">
            <span>Giảm giá voucher</span>
            <span>0đ</span>
          </div>
          <div class="checkout-summary-line">
            <span>Phí vận chuyển</span>
            <span>Nhà thuốc báo sau</span>
          </div>
        </div>
        <div class="checkout-summary-row">
          <span>Thành tiền</span>
          <strong id="cart-total">0đ</strong>
        </div>
        <p id="cart-unpriced" class="cart-note" hidden>
          Sản phẩm ghi "Liên hệ" chưa được tính vào tổng tiền. Nhà thuốc sẽ báo giá khi xác nhận đơn.
        </p>
        <p class="cart-note">Giá chưa gồm phí giao hàng. Nhà thuốc sẽ xác nhận lại giá, phí giao và cách thanh toán trước khi giao. Site chưa hỗ trợ mã giảm giá.</p>
        <button type="submit" class="btn checkout-submit">Hoàn tất</button>
        <p class="order-error" role="alert" hidden></p>
      </aside>
    </form>

    <div class="order-result cart-done" id="order-result" role="status" hidden></div>
  </div>

  <script>
    import { MAX_QTY, cartOriginalTotal, cartTotal, clearCart, formatVnd, getCart, hasUnpriced, removeItem, setQty, type CartItem } from '../lib/cart';
    import { supabase } from '../lib/supabase';

    const emptyBox = document.getElementById('cart-empty')!;
    const form = document.getElementById('order-form') as HTMLFormElement;
    const list = document.getElementById('cart-list')!;
    const totalEl = document.getElementById('cart-total')!;
    const originalTotalEl = document.getElementById('cart-original-total')!;
    const discountRowEl = document.getElementById('cart-discount-row')!;
    const discountEl = document.getElementById('cart-discount')!;
    const unpricedEl = document.getElementById('cart-unpriced')!;
    const result = document.getElementById('order-result')!;
    const error = form.querySelector<HTMLElement>('.order-error')!;

    function el<K extends keyof HTMLElementTagNameMap>(tag: K, className?: string, text?: string) {
      const node = document.createElement(tag);
      if (className) node.className = className;
      if (text !== undefined) node.textContent = text;
      return node;
    }

    function stepButton(label: string, action: string, id: string, text: string) {
      const button = el('button', 'qty-btn', text);
      button.type = 'button';
      button.setAttribute('aria-label', label);
      button.dataset.action = action;
      button.dataset.id = id;
      return button;
    }

    function row(item: CartItem) {
      const li = el('li', 'cart-item');
      if (item.image) {
        const img = el('img', 'cart-thumb');
        img.src = item.image;
        img.alt = '';
        img.width = 80;
        img.height = 80;
        li.append(img);
      }
      const info = el('div', 'cart-info');
      info.append(el('p', 'cart-name', item.name));
      if (item.unit) info.append(el('p', 'cart-unit', item.unit));
      const priceRow = el('p', 'cart-price', item.price === null ? 'Liên hệ' : formatVnd(item.price));
      // Giá gốc gạch ngang + nhãn "-X%", chỉ hiện khi sản phẩm đang khuyến mãi (originalPrice > price)
      if (item.price !== null && item.originalPrice && item.originalPrice > item.price) {
        const discount = Math.round((1 - item.price / item.originalPrice) * 100);
        const badge = el('span', 'sale-badge', `-${discount}%`);
        priceRow.append(' ', badge);
        info.append(priceRow, el('p', 'product-price-original', formatVnd(item.originalPrice)));
      } else {
        info.append(priceRow);
      }

      const qty = el('div', 'qty');
      const input = el('input');
      input.type = 'number';
      input.min = '1';
      input.max = String(MAX_QTY);
      input.value = String(item.qty);
      input.dataset.id = item.id;
      input.setAttribute('aria-label', `Số lượng ${item.name}`);
      qty.append(stepButton(`Giảm số lượng ${item.name}`, 'dec', item.id, '−'), input, stepButton(`Tăng số lượng ${item.name}`, 'inc', item.id, '+'));

      const remove = el('button', 'cart-remove', 'Xóa');
      remove.type = 'button';
      remove.dataset.action = 'remove';
      remove.dataset.id = item.id;
      remove.setAttribute('aria-label', `Xóa ${item.name} khỏi giỏ`);

      const actions = el('div', 'cart-actions');
      actions.append(qty, remove);
      li.append(info, actions);
      return li;
    }

    function render() {
      const items = getCart();
      emptyBox.hidden = items.length > 0 || !result.hidden;
      form.hidden = items.length === 0 || !result.hidden;
      list.replaceChildren(...items.map(row));
      // Giỏ chỉ có sản phẩm chưa có giá thì hiện "Liên hệ" thay vì "0đ"
      const total = cartTotal(items);
      const originalTotal = cartOriginalTotal(items);
      const discount = originalTotal - total;
      const unpriced = hasUnpriced(items);
      totalEl.textContent = total === 0 && unpriced ? 'Liên hệ' : formatVnd(total);
      originalTotalEl.textContent = originalTotal === 0 && unpriced ? 'Liên hệ' : formatVnd(originalTotal);
      // "Giảm giá trực tiếp" chỉ hiện khi THẬT SỰ có sản phẩm đang khuyến mãi trong giỏ (originalPrice
      // > price) — không phải dòng cố định luôn hiện, tránh hiện "-0đ" thừa khi giỏ không có sản
      // phẩm khuyến mãi nào.
      discountRowEl.hidden = discount <= 0;
      if (discount > 0) discountEl.textContent = `-${formatVnd(discount)}`;
      unpricedEl.hidden = !unpriced;
    }

    list.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button[data-action]');
      if (!button?.dataset.id) return;
      const id = button.dataset.id;
      const current = getCart().find((item) => item.id === id);
      if (!current) return;
      if (button.dataset.action === 'remove') removeItem(id);
      if (button.dataset.action === 'inc') setQty(id, current.qty + 1);
      if (button.dataset.action === 'dec') setQty(id, current.qty - 1);
    });
    list.addEventListener('change', (event) => {
      const input = event.target as HTMLInputElement;
      if (input.dataset.id) setQty(input.dataset.id, Number(input.value));
    });
    window.addEventListener('cart:change', render);
    window.addEventListener('storage', render);
    render();

    // Khách đã đăng nhập (Google hoặc email/mật khẩu) thì tự điền sẵn email tài khoản vào ô "Email
    // (không bắt buộc)" — để đơn vẫn gửi được email xác nhận dù khách không tự gõ gì, mà vẫn CHO SỬA
    // (không khóa ô lại) vì khách có thể muốn dùng email khác hoặc bỏ trống. Chỉ điền khi ô đang
    // trống, không ghi đè nếu khách đã gõ gì đó trước khi phần này tải xong.
    const ordererEmailInput = form.querySelector<HTMLInputElement>('[name="orderer_email"]')!;
    supabase.auth.getSession().then(({ data: { session } }) => {
      if (session?.user?.email && !ordererEmailInput.value) ordererEmailInput.value = session.user.email;
    });

    function showResult(nodes: Node[]) {
      result.replaceChildren(...nodes);
      result.hidden = false;
      form.hidden = true;
      emptyBox.hidden = true;
      result.scrollIntoView({ block: 'start' });
    }

    // Kiểm tra hợp lệ TỰ VIẾT (thay cho cảnh báo mặc định của trình duyệt, ví dụ "Please check this
    // box..." bằng tiếng Anh) — đọc thông báo tiếng Việt riêng cho từng ô từ thuộc tính
    // data-error-required/data-error-pattern/data-error-type đặt sẵn trên input, hiện thành viền đỏ
    // + dòng chữ nhỏ màu đỏ ngay dưới ô, đúng kiểu chuẩn phổ biến ở các website khác.
    type Validatable = HTMLInputElement | HTMLTextAreaElement;

    function fieldErrorMessage(field: Validatable): string {
      if (field.validity.valueMissing) return field.dataset.errorRequired ?? 'Vui lòng điền thông tin này.';
      if (field.validity.patternMismatch) return field.dataset.errorPattern ?? 'Thông tin chưa đúng định dạng.';
      if (field.validity.typeMismatch) return field.dataset.errorType ?? 'Thông tin chưa đúng định dạng.';
      return field.validationMessage;
    }

    function clearFieldError(field: Validatable) {
      field.classList.remove('field-invalid');
      const msg = form.querySelector<HTMLElement>(`.field-error[data-for="${field.name}"]`);
      if (msg) {
        msg.classList.remove('is-visible');
        msg.textContent = '';
      }
    }

    function showFieldError(field: Validatable, message: string) {
      field.classList.add('field-invalid');
      const msg = form.querySelector<HTMLElement>(`.field-error[data-for="${field.name}"]`);
      if (!msg) return;
      msg.textContent = message;
      msg.classList.add('is-visible');
    }

    function validateForm(): boolean {
      let firstInvalid: Validatable | null = null;
      form.querySelectorAll<Validatable>('input, textarea').forEach((field) => {
        if (field.type === 'hidden' || field.name === '_gotcha' || field.name === 'payment_method') return;
        clearFieldError(field);
        if (!field.checkValidity()) {
          showFieldError(field, fieldErrorMessage(field));
          if (!firstInvalid) firstInvalid = field;
        }
      });
      if (firstInvalid) {
        (firstInvalid as Validatable).focus();
        (firstInvalid as Validatable).scrollIntoView({ block: 'center', behavior: 'smooth' });
      }
      return !firstInvalid;
    }

    // Xóa lỗi ngay khi khách bắt đầu sửa lại ô đó, không cần đợi bấm gửi lần nữa mới hết đỏ
    form.addEventListener('input', (event) => {
      const field = event.target as Validatable;
      if (field.matches('input, textarea')) clearFieldError(field);
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      error.hidden = true;
      if (!validateForm()) return;
      const data = new FormData(form);
      if (data.get('_gotcha')) return; // thư rác

      const items = getCart();
      if (items.length === 0) return;
      const total = cartTotal(items);
      const originalTotal = cartOriginalTotal(items);
      const paymentMethod = String(data.get('payment_method') ?? 'cod');
      const hideProductName = data.get('hide_product_name') === 'on';
      // Mã đơn chỉ để khách/nhà thuốc tiện nhắc tới nhau (ví dụ qua điện thoại), không phải khóa
      // chính lưu trong cơ sở dữ liệu nào — sinh ngay ở trình duyệt, đủ dùng vì site chưa có hệ
      // thống quản lý đơn hàng thật.
      const orderId = `${Date.now().toString(36)}${Math.random().toString(36).slice(2, 5)}`.toUpperCase();
      const order = {
        orderId,
        items: items.map((item) => ({ id: item.id, name: item.name, qty: item.qty, price: item.price })),
        total,
        originalTotal,
        ordererName: String(data.get('orderer_name')).trim(),
        ordererPhone: String(data.get('orderer_phone')).trim(),
        ordererEmail: String(data.get('orderer_email') ?? '').trim(),
        name: String(data.get('recipient_name')).trim(),
        phone: String(data.get('recipient_phone')).trim(),
        address: String(data.get('address')).trim(),
        note: String(data.get('note') ?? '').trim(),
        hideProductName,
        paymentMethod,
      };

      // Khách đã đăng nhập (Tài khoản của tôi) thì lưu thêm 1 bản vào tài khoản để xem lại sau —
      // không thay thế việc gửi email bên dưới, chỉ lưu thêm song song. Lỗi ở đây (ví dụ mất mạng)
      // không được chặn việc gửi đơn chính.
      try {
        const {
          data: { session },
        } = await supabase.auth.getSession();
        if (session?.user) {
          await supabase.from('orders').insert({
            user_id: session.user.id,
            customer_name: order.name,
            phone: order.phone,
            address: order.address,
            note: order.note || null,
            payment_method: paymentMethod,
            items: order.items,
            total,
            orderer_name: order.ordererName,
            orderer_phone: order.ordererPhone,
            orderer_email: order.ordererEmail || null,
            hide_product_name: hideProductName,
          });
        }
      } catch {
        // không chặn việc gửi đơn chính nếu lưu vào tài khoản thất bại
      }

      // Gửi đơn thật qua Edge Function "send-order-email" (Supabase + Resend) — function tự gửi 2
      // email: báo nhà thuốc (luôn gửi, đây là kênh DUY NHẤT nhà thuốc biết có đơn mới, thay cho
      // luồng mở Zalo thủ công trước đây) và xác nhận cho khách (chỉ khi khách có điền email, ô này
      // không bắt buộc). Xem supabase/functions/send-order-email/index.ts và CLAUDE.md để biết cách
      // thiết lập Resend/deploy function.
      try {
        const { data: result, error: invokeError } = await supabase.functions.invoke('send-order-email', { body: order });
        if (invokeError) throw invokeError;
        clearCart();
        const message = result?.customerEmailSent
          ? `Đã gửi đơn thành công! Mã đơn #${orderId}. Chúng tôi đã gửi email xác nhận tới ${order.ordererEmail}, nhà thuốc sẽ gọi điện xác nhận lại trước khi giao.`
          : `Đã gửi đơn thành công! Mã đơn #${orderId}. Nhà thuốc sẽ gọi tới số ${order.phone} để xác nhận lại trước khi giao.`;
        showResult([el('p', undefined, message)]);
      } catch {
        error.innerHTML = '';
        error.append(
          el('span', undefined, 'Chưa gửi được đơn, có thể do mạng chập chờn. Bạn vui lòng thử lại hoặc '),
          (() => {
            const a = el('a', undefined, 'nhắn Zalo cho nhà thuốc');
            a.setAttribute('href', form.dataset.zalo ?? '');
            a.setAttribute('target', '_blank');
            a.setAttribute('rel', 'noopener');
            return a;
          })(),
          el('span', undefined, '.'),
        );
        error.hidden = false;
      }
    });
  </script>
</BaseLayout>
