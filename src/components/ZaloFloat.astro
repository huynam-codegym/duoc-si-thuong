---
import { site } from '../lib/site';
---

<!-- Biểu tượng Zalo nổi ở góc phải mọi trang: bấm để nhắn Zalo cá nhân của dược sĩ Thương -->
<a
  class="zalo-float"
  href={site.zaloHref}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`Nhắn Zalo cho dược sĩ Thương: ${site.phone}`}
  title="Nhắn Zalo cho dược sĩ Thương"
>
  <svg viewBox="0 0 56 56" width="56" height="56" aria-hidden="true" focusable="false">
    <path
      d="M16 3h24a13 13 0 0 1 13 13v18a13 13 0 0 1-13 13H20L8 53l3.2-10.4A13 13 0 0 1 3 34V16A13 13 0 0 1 16 3z"
      fill="#fff"
      stroke="#0068ff"
      stroke-width="3.5"
      stroke-linejoin="round"></path>
    <text
      x="28"
      y="31"
      text-anchor="middle"
      font-family="Arial, Helvetica, sans-serif"
      font-weight="700"
      font-size="15"
      fill="#0068ff">Zalo</text>
  </svg>
</a>
