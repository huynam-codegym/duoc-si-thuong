---
// Trang tĩnh dựng sẵn giá thường. Đoạn script này đổi sang giá Flash Sale (src/lib/flash-sale.ts) ở trình
// duyệt cho mọi khối có `data-flash-sync="<slug>"` (thẻ sản phẩm, trang chi tiết, thanh mua hàng dính) khi
// sản phẩm đang trong khung giờ, và tự đổi lại đúng lúc khung giờ bắt đầu/kết thúc nếu trang đang mở.
// Bên trong khối: [data-price-value] (giá), [data-price-original] (giá gạch ngang), [data-price-badge]
// (-X%), [data-price-compare] (khối chứa 2 cái trên, nếu có), [data-flash-note] (dòng nhắc giờ kết thúc).
// Giá trong giỏ và máy chủ tính riêng theo giờ (lib/cart.ts, send-order-email), không phụ thuộc chỗ này.
// Giá thường đọc từ nút [data-add-to-cart] bên trong khối; khối không có nút (menu lớn, kết quả tìm kiếm)
// thì tự mang `data-price`/`data-original-price`. Khối dựng bằng JS sau khi tải trang: bắn `flash:sync`.
---

<script>
  import { formatVnd } from '../lib/cart';
  import { flashPriceFor, nextFlashBoundary, priceNote } from '../lib/flash-sale';

  const show = (el: Element | null, text: string | null) => {
    if (!el) return;
    if (text === null) {
      (el as HTMLElement).hidden = true;
    } else {
      el.textContent = text;
      (el as HTMLElement).hidden = false;
    }
  };

  function sync() {
    document.querySelectorAll<HTMLElement>('[data-flash-sync]').forEach((box) => {
      const button = box.querySelector<HTMLElement>('[data-add-to-cart]');
      const valueEl = box.querySelector('[data-price-value]');
      const source = button ?? (box.dataset.price !== undefined ? box : null);
      if (!source || !valueEl) return;
      const base = Number(source.dataset.price) || null;
      const baseOriginal = Number(source.dataset.originalPrice) || null;
      const flash = flashPriceFor(box.dataset.flashSync!);
      const price = flash ? flash.price : base;
      const original = flash ? (baseOriginal ?? base) : baseOriginal;
      const discount = price && original && original > price ? Math.round((1 - price / original) * 100) : null;

      if (price) valueEl.textContent = formatVnd(price);
      show(box.querySelector('[data-price-original]'), discount !== null ? formatVnd(original!) : null);
      show(box.querySelector('[data-price-badge]'), discount !== null ? `-${discount}%` : null);
      const compare = box.querySelector<HTMLElement>('[data-price-compare]');
      if (compare) compare.hidden = discount === null;
      show(box.querySelector('[data-flash-note]'), flash ? priceNote(flash.slot) : null);
      box.classList.toggle('is-flash', !!flash);
    });
  }

  sync();
  window.addEventListener('flash:sync', sync);
  // Trang đang mở qua mốc 08:00/22:00: cập nhật giá trên trang và giỏ hàng (khay xem nhanh, trang giỏ)
  const schedule = () => {
    const next = nextFlashBoundary();
    if (next === undefined || next - Date.now() > 86_400_000) return;
    setTimeout(() => {
      sync();
      window.dispatchEvent(new CustomEvent('cart:change'));
      schedule();
    }, next - Date.now() + 500);
  };
  schedule();
</script>
