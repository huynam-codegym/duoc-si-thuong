---
import { Image } from 'astro:assets';
import logo from '../assets/logo.jpg';
import { categories } from '../lib/categories';
import { url } from '../lib/url';

const current = Astro.url.pathname;
---

<header class="site-header">
  <div class="container">
    <a class="brand" href={url('/')}>
      <Image class="brand-logo" src={logo} alt="" width={160} height={160} />
      <span>Dược Sĩ Thương</span>
    </a>
    <nav class="site-nav" aria-label="Chuyên mục">
      <ul>
        {
          Object.entries(categories).map(([slug, category]) => (
            <li>
              <a href={url(`/${slug}/`)} aria-current={current.startsWith(url(`/${slug}/`)) ? 'page' : undefined}>
                {category.name}
              </a>
            </li>
          ))
        }
        <li>
          <a href={url('/gioi-thieu/')} aria-current={current.startsWith(url('/gioi-thieu/')) ? 'page' : undefined}>
            Giới thiệu
          </a>
        </li>
        <li>
          <a href={url('/tim-kiem/')} aria-current={current.startsWith(url('/tim-kiem/')) ? 'page' : undefined}>
            Tìm kiếm
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>
