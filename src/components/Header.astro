---
import { Image, getImage } from 'astro:assets';
import logo from '../assets/logo.jpg';
import GroupIcon from './GroupIcon.astro';
import { categories, getGroups, type CategorySlug } from '../lib/categories';
import { departments, departmentSlugs, getProductGroups, type DepartmentSlug } from '../lib/departments';
import { activeIngredients, allActiveIngredients, herbalMaterials, ingredientCategories } from '../lib/drug-lookup';
import { formatPrice, getProducts } from '../lib/products';
import { site } from '../lib/site';
import { url } from '../lib/url';

const current = Astro.url.pathname;
const entries = Object.entries(categories) as [CategorySlug, (typeof categories)[CategorySlug]][];

// Từ khóa gợi ý dưới ô tìm kiếm (chỉ dùng từ có bài viết trên website để kết quả không trống)
const searchHints = ['Canxi', 'Sắt', 'Kẽm', 'Vitamin D', 'Vitamin C', 'Acid folic', 'Kháng sinh'];

// Menu thả xuống của mục "Thuốc" tạm thời thay bằng 3 trang "Tra cứu" (chủ website yêu cầu tháng 9/2026,
// theo mẫu Long Châu gửi: menu lớn 2 cột như các khu bán hàng, cột trái là 3 mục, cột phải xem trước gợi ý
// tên), thay cho danh sách nhóm bài viết "Kiến thức về thuốc" như trước — xem src/lib/drug-lookup.ts để
// biết vì sao chỉ có tên hoạt chất/dược liệu, chưa có trang chi tiết từng chất. Bấm vào một tên hiện gợi ý
// (ở đây hoặc ở 3 trang tra cứu) sẽ tìm tên đó trên toàn site (`/tim-kiem/?q=...`) vì chưa có trang riêng.
// Đổi lại danh sách nhóm bài viết: xóa các hằng số này và khôi phục đoạn dùng getGroups() như trước.
const drugLookupLinks = [
  { name: 'Tra cứu thuốc', href: url('/tra-cuu-thuoc/'), icon: 'search' as const },
  { name: 'Tra cứu dược chất', href: url('/tra-cuu-duoc-chat/'), icon: 'flask' as const },
  { name: 'Tra cứu dược liệu', href: url('/tra-cuu-duoc-lieu/'), icon: 'leaf' as const },
];
const drugLookupPanels = [
  {
    slug: 'tra-cuu-thuoc',
    name: 'Tra cứu thuốc',
    icon: 'search' as const,
    href: url('/tra-cuu-thuoc/'),
    categories: ingredientCategories,
    examples: activeIngredients.slice(0, 8).map((item) => item.name),
  },
  {
    slug: 'tra-cuu-duoc-chat',
    name: 'Tra cứu dược chất',
    icon: 'flask' as const,
    href: url('/tra-cuu-duoc-chat/'),
    categories: [],
    examples: allActiveIngredients.slice(0, 8),
  },
  {
    slug: 'tra-cuu-duoc-lieu',
    name: 'Tra cứu dược liệu',
    icon: 'leaf' as const,
    href: url('/tra-cuu-duoc-lieu/'),
    categories: [],
    examples: herbalMaterials.slice(0, 8),
  },
];

// Với mỗi khu bán hàng: sản phẩm của từng nhóm để hiện ở khung bên phải menu lớn (tối đa 5 sản phẩm mỗi nhóm)
const allProducts = await getProducts();
type MegaProduct = { id: string; name: string; price: number | undefined; image: string };
const shopMenus = await Promise.all(
  departmentSlugs.map(async (departmentSlug) => {
    const department = departments[departmentSlug];
    const groupEntries = getProductGroups(departmentSlug);
    const megaProducts = new Map<string, MegaProduct[]>();
    for (const [slug] of groupEntries) {
      const inGroup = allProducts.filter((product) => product.data.department === departmentSlug && product.data.group === slug).slice(0, 5);
      megaProducts.set(
        slug,
        await Promise.all(
          inGroup.map(async (product) => ({
            id: product.id,
            name: product.data.name,
            price: product.data.price,
            image: (await getImage({ src: product.data.image, width: 240, height: 240, format: 'webp' })).src,
          })),
        ),
      );
    }
    return { departmentSlug, department, groupEntries, megaProducts, href: url(`/${departmentSlug}/`) };
  }),
);

// Danh sách đơn giản (không có khung xem trước sản phẩm) dùng cho menu dạng ngăn kéo trên điện thoại/máy tính bảng
type DrawerChild = { name: string; href: string; icon: Awaited<ReturnType<typeof getProductGroups>>[number][1]['icon'] };
type DrawerSection = { name: string; href: string; current: boolean; children?: DrawerChild[] };
const drawerSections: DrawerSection[] = [
  ...shopMenus.map(({ department, groupEntries, href }): DrawerSection => ({
    name: department.name,
    href,
    current: current.startsWith(href),
    children: [
      { name: 'Xem tất cả sản phẩm', href, icon: 'cart' as const },
      ...groupEntries.map(([slug, group]) => ({ name: group.name, href: url(`${href}nhom/${slug}/`), icon: group.icon })),
    ],
  })),
  ...entries.map(([slug, category]): DrawerSection => {
    const groups = getGroups(slug);
    const href = url(`/${slug}/`);
    if (slug === 'kien-thuc-ve-thuoc') {
      return { name: category.name, href, current: current.startsWith(href), children: drugLookupLinks };
    }
    return {
      name: category.name,
      href,
      current: current.startsWith(href),
      children:
        groups.length > 0
          ? [
              { name: 'Xem tất cả bài viết', href, icon: 'book' as const },
              ...groups.map(([groupSlug, group]) => ({ name: group.name, href: url(`/${slug}/nhom/${groupSlug}/`), icon: group.icon })),
            ]
          : undefined,
    };
  }),
  { name: 'Giới thiệu', href: url('/gioi-thieu/'), current: current.startsWith(url('/gioi-thieu/')) },
];
---

<header class="site-header">
  <div class="container header-main">
    <span class="header-deco header-deco-left" aria-hidden="true">🌿</span>
    <span class="header-deco header-deco-right" aria-hidden="true">🌿</span>
    <button type="button" id="mobile-menu-btn" class="mobile-menu-btn" aria-expanded="false" aria-controls="mobile-drawer" aria-label="Mở menu">
      <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" focusable="false">
        <path d="M3 6h18M3 12h18M3 18h18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
    </button>
    <a class="brand" href={url('/')}>
      <Image class="brand-logo" src={logo} alt="" width={160} height={160} />
      <!-- Màn hình hẹp: "Dược Sĩ" và "Thương" xuống 2 dòng (xem .brand-name ở CSS) thay vì thu chữ quá nhỏ.
           Dấu cách giữa hai <span> vẫn nằm trong mã nguồn để trình đọc màn hình đọc đúng "Dược Sĩ Thương". -->
      <span class="brand-name"><span>Dược Sĩ</span> <span>Thương</span></span>
    </a>

    <div class="search-wrap">
    <form class="header-search" role="search" action={url('/tim-kiem/')} method="get">
      <label class="visually-hidden" for="header-q">Tìm sản phẩm hoặc bài viết</label>
      <div class="header-search-field">
        <input id="header-q" type="search" name="q" placeholder="Tìm kiếm..." autocomplete="off" />
        <!-- Chữ gợi ý hiện dần từng chữ kiểu đang gõ bàn phím (che chữ placeholder thật ở trên), để đọc
             được hết câu dài trên màn hình hẹp; tự ẩn khi ô có chữ hoặc đang được bấm vào (CSS), nội dung
             do script bên dưới gõ vào — xem .search-placeholder-type -->
        <span class="search-placeholder-scroll" aria-hidden="true">
          <span class="search-placeholder-type" data-text="Tìm sản phẩm, bài viết, câu hỏi về thuốc..."></span>
        </span>
      </div>
      <button type="submit" aria-label="Tìm kiếm">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
          <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2.2" />
          <path d="M16.5 16.5L21 21" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
        </svg>
      </button>
    </form>
    <ul class="search-hints" aria-label="Từ khóa gợi ý">
      {
        searchHints.map((hint) => (
          <li>
            <a href={url(`/tim-kiem/?q=${encodeURIComponent(hint)}`)}>{hint}</a>
          </li>
        ))
      }
    </ul>
    </div>

    <div class="cart-wrap" id="cartWrap">
      <a class="cart-link" href={url('/gio-hang/')} aria-label="Giỏ hàng">
        <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" focusable="false">
          <path
            d="M3 4h2.2l2.1 10.2a1 1 0 0 0 1 .8h8.6a1 1 0 0 0 1-.8L19.5 8H6.4"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
          <circle cx="9.5" cy="19" r="1.5" fill="currentColor"></circle>
          <circle cx="16.5" cy="19" r="1.5" fill="currentColor"></circle>
        </svg>
        <span class="cart-label">Giỏ hàng</span>
        <span class="cart-badge" id="cart-badge" hidden>0</span>
      </a>
    </div>
  </div>

  <!-- Gợi ý hiện ngay khi gõ vào ô tìm kiếm, và khay xem nhanh giỏ hàng (rê chuột vào biểu tượng giỏ,
       hoặc tự hiện ~2s sau khi bấm "Thêm vào giỏ"/"Chọn mua" — chỉ trên máy tính, xem script cuối trang).
       Cả hai đặt NGOÀI .header-main (dải nền có overflow:hidden để cắt icon lá trang trí, xem ghi chú
       "Bẫy đã gặp" ở CLAUDE.md) và tự định vị bằng toạ độ thật qua JS, không thì bị cắt mất. -->
  <div class="search-suggest" id="searchSuggest" role="listbox" aria-label="Gợi ý tìm kiếm" hidden></div>
  <div class="cart-dropdown" id="cartDropdown" aria-label="Xem nhanh giỏ hàng" hidden>
    <div class="cart-dropdown-list" id="cartDropdownList"></div>
    <div class="cart-dropdown-foot">
      <span id="cartDropdownCount"></span>
      <a class="btn btn-sm" href={url('/gio-hang/')}>Xem giỏ hàng</a>
    </div>
  </div>

  <div class="navbar">
    <div class="container">
      <nav class="site-nav" aria-label="Chuyên mục">
        <ul>
          {
            shopMenus.map(({ departmentSlug, department, groupEntries, megaProducts, href }) => (
              <li class="has-sub">
                <a href={href} aria-current={current.startsWith(href) ? 'page' : undefined}>{department.name}</a>
                <button
                  type="button"
                  class="sub-toggle"
                  aria-expanded="false"
                  aria-controls={`sub-shop-${departmentSlug}`}
                  aria-label={`Mở danh mục ${department.name}`}
                >
                  <svg viewBox="0 0 12 12" aria-hidden="true" focusable="false">
                    <path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </button>
                <div class="mega-menu" id={`sub-shop-${departmentSlug}`}>
                  <ul class="mega-groups">
                    <li class="mega-all">
                      <a href={href}>
                        <span class="sub-icon" aria-hidden="true"><GroupIcon icon="cart" size={17} /></span>
                        <span>Xem tất cả sản phẩm</span>
                      </a>
                    </li>
                    {
                      groupEntries.map(([slug, group], index) => (
                        <li>
                          <a
                            class={`mega-tab${index === 0 ? ' active' : ''}`}
                            href={url(`/${departmentSlug}/nhom/${slug}/`)}
                            data-panel={slug}
                          >
                            <span class="sub-icon" aria-hidden="true">
                              <GroupIcon icon={group.icon} size={17} />
                            </span>
                            <span>{group.name}</span>
                          </a>
                        </li>
                      ))
                    }
                  </ul>
                  <div class="mega-panels">
                    {
                      groupEntries.map(([slug, group], index) => {
                        const list = megaProducts.get(slug) ?? [];
                        return (
                          <section class={`mega-panel${index === 0 ? ' active' : ''}`} data-panel={slug} aria-label={group.name}>
                            <p class="mega-panel-head">
                              <strong>{group.name}</strong>
                              <a href={url(`/${departmentSlug}/nhom/${slug}/`)}>Xem tất cả ›</a>
                            </p>
                            {list.length > 0 ? (
                              <>
                                <p class="mega-panel-sub">Sản phẩm trong nhóm</p>
                                <ul class="mega-products">
                                  {list.map((product) => (
                                    <li>
                                      <a href={url(`/${departmentSlug}/${product.id}/`)}>
                                        <img src={product.image} alt="" width="120" height="120" loading="lazy" />
                                        <span class="mega-product-name">{product.name}</span>
                                        <span class="mega-product-price">{formatPrice(product.price)}</span>
                                      </a>
                                    </li>
                                  ))}
                                </ul>
                              </>
                            ) : (
                              <p class="mega-empty">{group.description} Nhóm này đang cập nhật sản phẩm.</p>
                            )}
                          </section>
                        );
                      })
                    }
                  </div>
                </div>
              </li>
            ))
          }
          {
            entries.map(([slug, category]) => {
              const groups = getGroups(slug);
              const href = url(`/${slug}/`);
              const isCurrent = current.startsWith(href);
              const isDrugLookup = slug === 'kien-thuc-ve-thuoc';
              if (isDrugLookup) {
                return (
                  <li class="has-sub">
                    <a href={href} aria-current={isCurrent ? 'page' : undefined}>{category.name}</a>
                    <button type="button" class="sub-toggle" aria-expanded="false" aria-controls={`sub-${slug}`} aria-label={`Mở danh sách ${category.name}`}>
                      <svg viewBox="0 0 12 12" aria-hidden="true" focusable="false">
                        <path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </button>
                    <div class="mega-menu" id={`sub-${slug}`}>
                      <ul class="mega-groups">
                        {drugLookupPanels.map((panel, index) => (
                          <li>
                            <a class={`mega-tab${index === 0 ? ' active' : ''}`} href={panel.href} data-panel={panel.slug}>
                              <span class="sub-icon" aria-hidden="true"><GroupIcon icon={panel.icon} size={17} /></span>
                              <span>{panel.name}</span>
                            </a>
                          </li>
                        ))}
                      </ul>
                      <div class="mega-panels">
                        {drugLookupPanels.map((panel, index) => (
                          <section class={`mega-panel${index === 0 ? ' active' : ''}`} data-panel={panel.slug} aria-label={panel.name}>
                            <p class="mega-panel-head">
                              <strong>{panel.name}</strong>
                              <a href={panel.href}>Xem tất cả ›</a>
                            </p>
                            {panel.categories.length > 0 && (
                              <ul class="mega-cats">
                                {panel.categories.map((cat) => (
                                  <li>
                                    <a href={panel.href}>
                                      <GroupIcon icon={cat.icon} size={16} />
                                      <span>{cat.name}</span>
                                    </a>
                                  </li>
                                ))}
                              </ul>
                            )}
                            <p class="mega-panel-sub">Gợi ý tên thường gặp</p>
                            <ul class="mega-terms">
                              {panel.examples.map((name) => (
                                <li><a href={url(`/tim-kiem/?q=${encodeURIComponent(name)}`)}>{name}</a></li>
                              ))}
                            </ul>
                          </section>
                        ))}
                      </div>
                    </div>
                  </li>
                );
              }
              return groups.length > 0 ? (
                <li class="has-sub">
                  <a href={href} aria-current={isCurrent ? 'page' : undefined}>
                    {category.name}
                  </a>
                  <button
                    type="button"
                    class="sub-toggle"
                    aria-expanded="false"
                    aria-controls={`sub-${slug}`}
                    aria-label={`Mở danh sách ${category.name}`}
                  >
                    <svg viewBox="0 0 12 12" aria-hidden="true" focusable="false">
                      <path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </button>
                  <ul class="submenu" id={`sub-${slug}`}>
                    <li>
                      <a href={href}>
                        <span class="sub-icon" aria-hidden="true">
                          <GroupIcon icon="book" size={17} />
                        </span>
                        <span>Xem tất cả bài viết</span>
                      </a>
                    </li>
                    {groups.map(([groupSlug, group]) => (
                      <li>
                        <a href={url(`/${slug}/nhom/${groupSlug}/`)}>
                          <span class="sub-icon" aria-hidden="true">
                            <GroupIcon icon={group.icon} size={17} />
                          </span>
                          <span>{group.name}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </li>
              ) : (
                <li>
                  <a href={href} aria-current={isCurrent ? 'page' : undefined}>
                    {category.name}
                  </a>
                </li>
              );
            })
          }
          <li>
            <a href={url('/gioi-thieu/')} aria-current={current.startsWith(url('/gioi-thieu/')) ? 'page' : undefined}>
              Giới thiệu
            </a>
          </li>
        </ul>
      </nav>
    </div>
  </div>

  <div class="mobile-drawer" id="mobile-drawer" hidden>
    <div class="mobile-drawer-backdrop" data-close="true"></div>
    <div class="mobile-drawer-panel" role="dialog" aria-modal="true" aria-label="Menu">
      <div class="mobile-drawer-head">
        <a class="mobile-drawer-brand" href={url('/')}>
          <Image class="brand-logo" src={logo} alt="" width={80} height={80} />
          <span>Dược Sĩ Thương</span>
        </a>
        <button type="button" class="mobile-drawer-close" data-close="true" aria-label="Đóng menu">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
            <path d="M5 5l14 14M19 5L5 19" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
        </button>
      </div>
      <nav class="mobile-drawer-nav" aria-label="Menu chính">
        <ul>
          {
            drawerSections.map((section) => (
              <li class="mobile-drawer-item">
                {section.children ? (
                  <>
                    <div class="mobile-drawer-row">
                      <a href={section.href} aria-current={section.current ? 'page' : undefined}>
                        {section.name}
                      </a>
                      <button type="button" class="mobile-drawer-toggle" aria-expanded="false" aria-label={`Mở ${section.name}`}>
                        <svg viewBox="0 0 12 12" aria-hidden="true" focusable="false">
                          <path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                      </button>
                    </div>
                    <ul class="mobile-drawer-sub">
                      {section.children.map((child) => (
                        <li>
                          <a href={child.href}>
                            <span class="sub-icon" aria-hidden="true">
                              <GroupIcon icon={child.icon} size={17} />
                            </span>
                            <span>{child.name}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </>
                ) : (
                  <a href={section.href} aria-current={section.current ? 'page' : undefined}>
                    {section.name}
                  </a>
                )}
              </li>
            ))
          }
        </ul>
      </nav>
      <div class="mobile-drawer-foot">
        <a class="btn" href={site.zaloHref} target="_blank" rel="noopener noreferrer">
          Nhắn Zalo tư vấn: {site.phone}
        </a>
      </div>
    </div>
  </div>
</header>

<div class="toast" id="toast" role="status" aria-live="polite" hidden></div>

<!-- Khay chọn số lượng khi bấm "Chọn mua" trên thẻ sản phẩm — CHỈ trên điện thoại/máy tính bảng
     (trang chi tiết sản phẩm đã có sẵn ô chọn số lượng riêng nên không cần khay này, xem script). -->
<div class="cart-sheet-backdrop" id="cartSheetBackdrop" hidden></div>
<div class="cart-sheet" id="cartSheet" role="dialog" aria-modal="true" aria-labelledby="cartSheetTitle" hidden>
  <div class="cart-sheet-head">
    <h2 id="cartSheetTitle">Chọn số lượng</h2>
    <button type="button" class="cart-sheet-close" id="cartSheetClose" aria-label="Đóng">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
        <path d="M5 5l14 14M19 5L5 19" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
      </svg>
    </button>
  </div>
  <div class="cart-sheet-product">
    <img id="cartSheetImg" src="" alt="" width="64" height="64" />
    <div>
      <p class="cart-sheet-name" id="cartSheetName"></p>
      <p class="cart-sheet-price">
        <span id="cartSheetPrice"></span>
        <span id="cartSheetSaleBadge" class="sale-badge" hidden></span>
      </p>
      <p class="product-price-original" id="cartSheetOriginalPrice" hidden></p>
    </div>
  </div>
  <div class="buy-qty">
    <span id="cartSheetQtyLabel">Chọn số lượng</span>
    <div class="qty" role="group" aria-labelledby="cartSheetQtyLabel">
      <button type="button" class="qty-btn" id="cartSheetMinus" aria-label="Giảm số lượng">−</button>
      <input id="cartSheetQty" type="number" min="1" max="20" value="1" inputmode="numeric" aria-labelledby="cartSheetQtyLabel" />
      <button type="button" class="qty-btn" id="cartSheetPlus" aria-label="Tăng số lượng">+</button>
    </div>
  </div>
  <div class="actions cart-sheet-actions">
    <button type="button" class="btn btn-outline" id="cartSheetAdd">Thêm vào giỏ</button>
    <button type="button" class="btn" id="cartSheetBuy">Mua ngay</button>
  </div>
</div>

<script>
  import { MAX_QTY, addToCart, cartCount, formatVnd, getCart, removeItem, type CartItem } from '../lib/cart';
  import { url } from '../lib/url';

  // Chữ gợi ý trong ô tìm kiếm: hiện dần từng chữ kiểu đang gõ bàn phím, gõ xong dừng một lúc rồi XÓA
  // HẾT NGAY một lần (không xóa dần từng chữ), dừng một lúc rồi gõ lại từ đầu (lặp lại mãi). Tắt hẳn
  // hiệu ứng nếu người dùng chọn "giảm chuyển động" trên máy.
  const typeTarget = document.querySelector<HTMLElement>('.search-placeholder-type');
  const typeScroller = typeTarget?.closest<HTMLElement>('.search-placeholder-scroll');
  if (typeTarget && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const fullText = typeTarget.dataset.text ?? '';
    let i = 0;
    function tick() {
      if (!typeTarget) return;
      i += 1;
      typeTarget.textContent = fullText.slice(0, i);
      // Cuộn theo con trỏ, giống ô nhập liệu thật tự cuộn khi chữ dài hơn bề rộng ô
      if (typeScroller) typeScroller.scrollLeft = typeScroller.scrollWidth;
      if (i >= fullText.length) {
        window.setTimeout(() => {
          typeTarget.textContent = ''; // xóa hết ngay một lần, không xóa dần từng chữ
          i = 0;
          window.setTimeout(tick, 500); // dừng một lúc trước khi gõ lại
        }, 1800); // dừng một lúc khi gõ xong
        return;
      }
      window.setTimeout(tick, 55);
    }
    tick();
  } else if (typeTarget) {
    typeTarget.textContent = typeTarget.dataset.text ?? '';
  }

  // Gợi ý hiện ngay khi gõ vào ô tìm kiếm đầu trang (không cần bấm nút tìm kiếm), dùng lại chỉ mục
  // Pagefind có sẵn (chỉ tải khi người dùng thật sự bấm vào ô, để không nặng các trang không tìm kiếm).
  // Bấm Enter hoặc nút tìm kiếm vẫn đi tới /tim-kiem/ như bình thường (hành vi mặc định của <form>).
  const searchInput = document.getElementById('header-q') as HTMLInputElement | null;
  const searchSuggest = document.getElementById('searchSuggest');
  const searchWrap = document.querySelector<HTMLElement>('.search-wrap');
  const siteHeader = document.querySelector<HTMLElement>('.site-header');
  if (searchInput && searchSuggest) {
    // .search-suggest nằm ngoài .header-main (xem lý do trong CSS) nên phải tự tính toạ độ theo
    // .site-header (điểm neo position:relative) thay vì dựa vào CSS top/left cố định.
    function positionSuggest() {
      if (!searchWrap || !siteHeader) return;
      const wrapRect = searchWrap.getBoundingClientRect();
      const headerRect = siteHeader.getBoundingClientRect();
      searchSuggest.style.top = `${wrapRect.bottom - headerRect.top}px`;
      searchSuggest.style.left = `${wrapRect.left - headerRect.left}px`;
      searchSuggest.style.width = `${wrapRect.width}px`;
    }
    window.addEventListener('resize', () => {
      if (!searchSuggest.hidden) positionSuggest();
    });
    let pagefind: { search: (q: string) => Promise<{ results: { id: string; data: () => Promise<{ url: string; meta: { title?: string }; excerpt: string }> }[] }> } | null = null;
    let loadingPagefind: Promise<void> | null = null;
    function loadPagefind() {
      if (!loadingPagefind) {
        loadingPagefind = import(/* @vite-ignore */ url('/pagefind/pagefind.js'))
          .then((mod) => {
            pagefind = mod;
          })
          .catch(() => {
            // Chưa build (npm run dev) hoặc lỗi tải: bỏ qua, gõ Enter vẫn dùng được trang /tim-kiem/
          });
      }
      return loadingPagefind;
    }

    function hideSuggest() {
      searchSuggest.hidden = true;
      searchSuggest.innerHTML = '';
    }

    function stripTags(html: string): string {
      const div = document.createElement('div');
      div.innerHTML = html;
      return div.textContent ?? '';
    }

    let requestId = 0;
    async function runSearch(term: string) {
      await loadPagefind();
      if (!pagefind) return;
      const myRequest = ++requestId;
      const search = await pagefind.search(term);
      if (myRequest !== requestId || term !== searchInput?.value.trim()) return; // gõ tiếp trong lúc chờ, bỏ kết quả cũ
      const top = await Promise.all(search.results.slice(0, 6).map((r) => r.data()));
      if (myRequest !== requestId) return;
      if (top.length === 0) {
        hideSuggest();
        return;
      }
      searchSuggest.innerHTML = '';
      top.forEach((item) => {
        const a = document.createElement('a');
        a.href = item.url;
        a.setAttribute('role', 'option');
        const title = document.createElement('span');
        title.className = 'search-suggest-title';
        title.textContent = item.meta.title ?? item.url;
        const excerpt = document.createElement('span');
        excerpt.className = 'search-suggest-excerpt';
        excerpt.textContent = stripTags(item.excerpt);
        a.append(title, excerpt);
        searchSuggest.append(a);
      });
      const seeAll = document.createElement('a');
      seeAll.href = url(`/tim-kiem/?q=${encodeURIComponent(term)}`);
      seeAll.className = 'search-suggest-all';
      seeAll.textContent = `Xem tất cả kết quả cho "${term}" ›`;
      searchSuggest.append(seeAll);
      positionSuggest();
      searchSuggest.hidden = false;
    }

    let debounceTimer: number | undefined;
    searchInput.addEventListener('input', () => {
      const term = searchInput.value.trim();
      window.clearTimeout(debounceTimer);
      if (term.length < 2) {
        hideSuggest();
        return;
      }
      debounceTimer = window.setTimeout(() => runSearch(term), 200);
    });
    searchInput.addEventListener('focus', loadPagefind);
    searchInput.addEventListener('focus', () => {
      if (searchInput.value.trim().length >= 2 && searchSuggest.innerHTML) {
        positionSuggest();
        searchSuggest.hidden = false;
      }
    });
    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Node)) return;
      if (!searchInput.contains(event.target) && !searchSuggest.contains(event.target)) hideSuggest();
    });
    searchInput.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') hideSuggest();
    });
  }

  // Mở/đóng danh sách thả xuống bằng nút mũi tên (dùng cho điện thoại và bàn phím).
  // Trên máy tính, danh sách còn tự mở khi rê chuột (xử lý bằng CSS).
  const items = document.querySelectorAll<HTMLElement>('.site-nav .has-sub');

  function setOpen(item: HTMLElement, open: boolean) {
    item.classList.toggle('open', open);
    item.querySelector('.sub-toggle')?.setAttribute('aria-expanded', String(open));
  }

  items.forEach((item) => {
    item.querySelector('.sub-toggle')?.addEventListener('click', () => {
      setOpen(item, !item.classList.contains('open'));
    });
  });

  document.addEventListener('click', (event) => {
    items.forEach((item) => {
      if (!item.contains(event.target as Node)) setOpen(item, false);
    });
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') items.forEach((item) => setOpen(item, false));
  });

  // Menu dạng ngăn kéo trên điện thoại/máy tính bảng (bấm biểu tượng 3 gạch)
  const menuBtn = document.getElementById('mobile-menu-btn') as HTMLButtonElement | null;
  const drawer = document.getElementById('mobile-drawer');

  function openDrawer() {
    if (!drawer || !menuBtn) return;
    drawer.hidden = false;
    document.body.style.overflow = 'hidden';
    menuBtn.setAttribute('aria-expanded', 'true');
    requestAnimationFrame(() => drawer.classList.add('open'));
  }

  function closeDrawer() {
    if (!drawer || !menuBtn) return;
    drawer.classList.remove('open');
    document.body.style.overflow = '';
    menuBtn.setAttribute('aria-expanded', 'false');
    window.setTimeout(() => {
      if (!drawer.classList.contains('open')) drawer.hidden = true;
    }, 220);
  }

  menuBtn?.addEventListener('click', () => (drawer?.hidden ? openDrawer() : closeDrawer()));
  drawer?.querySelectorAll<HTMLElement>('[data-close]').forEach((el) => el.addEventListener('click', closeDrawer));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && drawer && !drawer.hidden) closeDrawer();
  });

  // Mở/đóng từng nhóm trong ngăn kéo (kiểu accordion)
  drawer?.querySelectorAll<HTMLButtonElement>('.mobile-drawer-toggle').forEach((toggle) => {
    toggle.addEventListener('click', () => {
      const item = toggle.closest<HTMLElement>('.mobile-drawer-item');
      if (!item) return;
      const open = !item.classList.contains('open');
      item.classList.toggle('open', open);
      toggle.setAttribute('aria-expanded', String(open));
    });
  });

  // Menu lớn: rê chuột hoặc focus vào một nhóm thì khung bên phải đổi sang sản phẩm của nhóm đó.
  // Mỗi khu bán hàng có menu lớn riêng, nên chỉ tìm tab/khung trong CÙNG một menu.
  document.querySelectorAll<HTMLElement>('.mega-menu').forEach((menu) => {
    const tabs = menu.querySelectorAll<HTMLElement>('.mega-tab');
    const panels = menu.querySelectorAll<HTMLElement>('.mega-panel');
    function showPanel(slug: string | undefined) {
      tabs.forEach((tab) => tab.classList.toggle('active', tab.dataset.panel === slug));
      panels.forEach((panel) => panel.classList.toggle('active', panel.dataset.panel === slug));
    }
    tabs.forEach((tab) => {
      tab.addEventListener('mouseenter', () => showPanel(tab.dataset.panel));
      tab.addEventListener('focus', () => showPanel(tab.dataset.panel));
    });
  });

  // Số sản phẩm trên biểu tượng giỏ hàng
  const badge = document.getElementById('cart-badge');
  function updateBadge() {
    if (!badge) return;
    const count = cartCount();
    badge.textContent = String(count);
    badge.hidden = count === 0;
  }
  updateBadge();

  // Từ 77rem trở lên coi là "máy tính" — khớp đúng ngưỡng ẩn/hiện nút 3 gạch và thanh menu ngang
  // (@media 76.99rem/77rem, xem mục "Bẫy kỹ thuật rem" trong CLAUDE.md; TRƯỚC ĐÂY nhầm dùng 64rem ở
  // đây, lệch với ngưỡng thật khiến khổ 64-77rem vừa hiện menu ngăn kéo [coi là điện thoại] vừa hiện
  // khay xem nhanh giỏ hàng kiểu máy tính — đã gộp về cùng một mốc): hiện khay xem nhanh giỏ hàng khi
  // rê chuột / sau khi thêm vào giỏ. Dưới mức đó dùng khay chọn số lượng + thông báo dạng chữ đơn giản.
  function isDesktop() {
    return window.matchMedia('(min-width: 77rem)').matches;
  }

  // --- Khay xem nhanh giỏ hàng (rê chuột vào biểu tượng giỏ, hoặc tự hiện ~2s sau khi thêm sản phẩm) ---
  // Đặt ngoài .header-main (xem ghi chú ở markup phía trên) nên không dùng CSS :hover lồng thẻ được,
  // phải tự định vị bằng toạ độ thật (giống #searchSuggest) và tự bật/tắt bằng JS.
  const cartWrap = document.getElementById('cartWrap');
  const cartDropdown = document.getElementById('cartDropdown');
  const cartDropdownList = document.getElementById('cartDropdownList');
  const cartDropdownCount = document.getElementById('cartDropdownCount');

  function positionCartDropdown() {
    if (!cartDropdown || !cartWrap || !siteHeader) return;
    const wrapRect = cartWrap.getBoundingClientRect();
    const headerRect = siteHeader.getBoundingClientRect();
    cartDropdown.style.top = `${wrapRect.bottom - headerRect.top + 8}px`;
    cartDropdown.style.right = `${headerRect.right - wrapRect.right}px`;
  }

  function renderCartDropdown() {
    if (!cartDropdownList || !cartDropdownCount) return;
    const items = getCart();
    cartDropdownList.innerHTML = '';
    if (items.length === 0) {
      const empty = document.createElement('p');
      empty.className = 'cart-dropdown-empty';
      empty.textContent = 'Giỏ hàng đang trống';
      cartDropdownList.append(empty);
    } else {
      items.forEach((item: CartItem) => {
        const row = document.createElement('div');
        row.className = 'cart-dropdown-item';
        const img = document.createElement('img');
        img.src = item.image;
        img.alt = '';
        img.width = 44;
        img.height = 44;
        img.loading = 'lazy';
        const info = document.createElement('div');
        info.className = 'cart-dropdown-item-info';
        const nameEl = document.createElement('p');
        nameEl.className = 'cart-dropdown-item-name';
        nameEl.textContent = item.name;
        const priceEl = document.createElement('p');
        priceEl.className = 'cart-dropdown-item-price';
        priceEl.textContent = `${item.price !== null ? formatVnd(item.price) : 'Liên hệ'} · x${item.qty}${item.unit ? ' ' + item.unit : ''}`;
        info.append(nameEl, priceEl);
        // Giá gốc gạch ngang, chỉ hiện khi sản phẩm đang khuyến mãi (originalPrice > price)
        if (item.price !== null && item.originalPrice && item.originalPrice > item.price) {
          const originalEl = document.createElement('p');
          originalEl.className = 'product-price-original';
          originalEl.textContent = formatVnd(item.originalPrice);
          info.append(originalEl);
        }
        const removeBtn = document.createElement('button');
        removeBtn.type = 'button';
        removeBtn.className = 'cart-dropdown-remove';
        removeBtn.setAttribute('aria-label', `Xóa "${item.name}" khỏi giỏ hàng`);
        removeBtn.dataset.removeId = item.id;
        removeBtn.innerHTML =
          '<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M4 7h16M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2m-9 0 1 13a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1l1-13" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>';
        row.append(img, info, removeBtn);
        cartDropdownList.append(row);
      });
    }
    // Đếm số LOẠI sản phẩm (số dòng), không phải tổng số lượng — 1 sản phẩm x3 vẫn là "1 sản phẩm".
    // Tổng số lượng đã hiện riêng trên biểu tượng giỏ hàng (cart-badge).
    cartDropdownCount.textContent = items.length ? `${items.length} sản phẩm` : '';
  }

  cartDropdownList?.addEventListener('click', (event) => {
    const btn = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-remove-id]');
    if (!btn?.dataset.removeId) return;
    removeItem(btn.dataset.removeId);
    renderCartDropdown();
  });

  // Ảnh sản phẩm "bay" từ chỗ vừa bấm về biểu tượng giỏ hàng, rồi mới hiện khay xem nhanh (xem hàm
  // flyToCart bên dưới) — bỏ qua hiệu ứng bay nếu người dùng chọn "giảm chuyển động" trên máy (cùng
  // cách kiểm tra như hiệu ứng gõ chữ ở ô tìm kiếm phía trên), khay xem nhanh vẫn hiện ngay lập tức.
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  type Rect = { left: number; top: number; width: number; height: number };
  // fromRect chụp SẴN lúc bấm (trước khi trang kịp cuộn) — không dùng lại phần tử sống, vì nếu trang
  // đang cuộn lên đầu (xem waitScrollTop bên dưới) thì vị trí thật của phần tử đã đổi, ảnh sẽ bay từ
  // chỗ sai. toRect (giỏ hàng) thì đọc TẠI THỜI ĐIỂM BẮT ĐẦU BAY (sau khi trang cuộn xong), vì biểu
  // tượng giỏ hàng ở đầu trang chỉ hiện đúng chỗ sau khi cuộn lên xong.
  function flyToCart(imageSrc: string, fromRect: Rect): Promise<void> {
    if (!cartWrap || reduceMotion) return Promise.resolve();
    const toRect = cartWrap.getBoundingClientRect();
    if (fromRect.width === 0 || toRect.width === 0) return Promise.resolve();
    const flyer = document.createElement('img');
    flyer.src = imageSrc;
    flyer.alt = '';
    flyer.className = 'cart-fly';
    flyer.style.left = `${fromRect.left}px`;
    flyer.style.top = `${fromRect.top}px`;
    flyer.style.width = `${fromRect.width}px`;
    flyer.style.height = `${fromRect.height}px`;
    document.body.append(flyer);
    const dx = toRect.left + toRect.width / 2 - (fromRect.left + fromRect.width / 2);
    const dy = toRect.top + toRect.height / 2 - (fromRect.top + fromRect.height / 2);
    return new Promise((resolve) => {
      requestAnimationFrame(() => {
        flyer.style.transform = `translate(${dx}px, ${dy}px) scale(0.15)`;
        flyer.style.opacity = '0.25';
      });
      let done = false;
      const finish = () => {
        if (done) return;
        done = true;
        flyer.remove();
        resolve();
      };
      flyer.addEventListener('transitionend', finish, { once: true });
      window.setTimeout(finish, 750); // phòng khi transitionend không bắn (ví dụ đổi tab lúc đang bay)
    });
  }
  // Tìm ảnh sản phẩm gần nút vừa bấm để làm ảnh bay: ảnh trên thẻ sản phẩm, hoặc ảnh chính ở trang
  // chi tiết sản phẩm (khu vực .product-gallery). Đọc luôn vị trí (rect) ngay tại đây, lúc phần tử
  // còn chắc chắn ở đúng chỗ người dùng vừa thấy khi bấm.
  function findFlyImage(button: HTMLElement): { src: string; rect: Rect } | null {
    const cardImg = button.closest('.product-card')?.querySelector<HTMLImageElement>('.product-thumb');
    if (cardImg?.currentSrc || cardImg?.src) return { src: cardImg.currentSrc || cardImg.src, rect: cardImg.getBoundingClientRect() };
    const galleryImg = document.getElementById('galleryMainImg') as HTMLImageElement | null;
    if (galleryImg?.src) return { src: galleryImg.src, rect: galleryImg.getBoundingClientRect() };
    return null;
  }
  // Nếu trang đang cuộn xuống (biểu tượng giỏ hàng ở đầu trang không còn trong khung nhìn), tự cuộn
  // mượt lên đầu trang trước khi bay/hiện khay, để người dùng THẤY được cả hai — đúng điều đã yêu cầu.
  function waitScrollTop(): Promise<void> {
    if (window.scrollY <= 4) return Promise.resolve();
    window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' });
    return new Promise((resolve) => {
      const started = performance.now();
      function check() {
        if (window.scrollY <= 4 || performance.now() - started > 900) {
          resolve();
          return;
        }
        requestAnimationFrame(check);
      }
      requestAnimationFrame(check);
    });
  }

  let cartHideTimer: number | undefined;
  let cartCloseGrace: number | undefined;
  function openCartDropdown() {
    if (!cartDropdown || !isDesktop()) return;
    renderCartDropdown();
    positionCartDropdown();
    cartDropdown.hidden = false;
    requestAnimationFrame(() => cartDropdown.classList.add('open'));
  }
  function closeCartDropdown() {
    if (!cartDropdown) return;
    cartDropdown.classList.remove('open');
    window.setTimeout(() => {
      if (cartDropdown && !cartDropdown.classList.contains('open')) cartDropdown.hidden = true;
    }, 200);
  }
  // Tự hiện khay ~2 giây sau khi thêm vào giỏ; không tự ẩn nếu chuột đang ở trên biểu tượng/khay.
  function flashCartDropdown() {
    if (!isDesktop()) return;
    openCartDropdown();
    clearTimeout(cartHideTimer);
    cartHideTimer = window.setTimeout(() => {
      if (!cartWrap?.matches(':hover') && !cartDropdown?.matches(':hover')) closeCartDropdown();
    }, 2000);
  }
  [cartWrap, cartDropdown].forEach((el) => {
    el?.addEventListener('mouseenter', () => {
      if (!isDesktop()) return;
      clearTimeout(cartCloseGrace);
      clearTimeout(cartHideTimer);
      openCartDropdown();
    });
    el?.addEventListener('mouseleave', () => {
      clearTimeout(cartCloseGrace);
      cartCloseGrace = window.setTimeout(closeCartDropdown, 150);
    });
  });
  window.addEventListener('cart:change', () => {
    updateBadge();
    if (cartDropdown && !cartDropdown.hidden) renderCartDropdown();
  });
  window.addEventListener('storage', updateBadge);
  window.addEventListener('resize', () => {
    if (cartDropdown && !cartDropdown.hidden) positionCartDropdown();
  });

  // --- Thông báo dạng chữ, chỉ dùng trên điện thoại/máy tính bảng (máy tính dùng khay xem nhanh ở trên) ---
  const toast = document.getElementById('toast');
  let toastTimer: number | undefined;
  function showToast(message: string) {
    if (!toast) return;
    toast.textContent = message;
    toast.hidden = false;
    clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => (toast.hidden = true), 2500);
  }

  // --- Khay chọn số lượng khi bấm "Chọn mua" trên thẻ sản phẩm, chỉ trên điện thoại/máy tính bảng
  // (trang chi tiết sản phẩm đã có sẵn ô chọn số lượng riêng ngay trên trang nên bỏ qua khay này) ---
  const cartSheetBackdrop = document.getElementById('cartSheetBackdrop');
  const cartSheet = document.getElementById('cartSheet');
  const cartSheetImg = document.getElementById('cartSheetImg') as HTMLImageElement | null;
  const cartSheetName = document.getElementById('cartSheetName');
  const cartSheetPrice = document.getElementById('cartSheetPrice');
  const cartSheetSaleBadge = document.getElementById('cartSheetSaleBadge');
  const cartSheetOriginalPrice = document.getElementById('cartSheetOriginalPrice');
  const cartSheetQty = document.getElementById('cartSheetQty') as HTMLInputElement | null;
  let sheetProduct: Omit<CartItem, 'qty'> | null = null;

  // product.originalPrice đi kèm suốt (lưu cả vào giỏ hàng, xem CartItem trong lib/cart.ts) để giỏ
  // hàng/khay xem nhanh cũng hiện lại được giá gốc gạch ngang + nhãn -X% cho sản phẩm đang khuyến mãi,
  // không chỉ trang chi tiết/thẻ sản phẩm. Tự tính % giảm ngay tại đây thay vì import discountPercent()
  // từ lib/products.ts vì file đó có `import ... from 'astro:content'` ở đầu — import vào script chạy
  // ở trình duyệt sẽ lỗi build ServerOnlyModule.
  function openCartSheet(product: Omit<CartItem, 'qty'>) {
    if (!cartSheet || !cartSheetBackdrop || !cartSheetImg || !cartSheetName || !cartSheetPrice || !cartSheetQty) return;
    sheetProduct = product;
    cartSheetImg.src = product.image;
    cartSheetName.textContent = product.name;
    cartSheetPrice.textContent = product.price !== null ? formatVnd(product.price) : 'Liên hệ';
    const discount =
      product.price !== null && product.originalPrice && product.originalPrice > product.price
        ? Math.round((1 - product.price / product.originalPrice) * 100)
        : null;
    if (cartSheetSaleBadge) {
      cartSheetSaleBadge.hidden = discount === null;
      cartSheetSaleBadge.textContent = discount !== null ? `-${discount}%` : '';
    }
    if (cartSheetOriginalPrice) {
      cartSheetOriginalPrice.hidden = discount === null;
      cartSheetOriginalPrice.textContent = discount !== null && product.originalPrice ? formatVnd(product.originalPrice) : '';
    }
    cartSheetQty.value = '1';
    cartSheetBackdrop.hidden = false;
    cartSheet.hidden = false;
    document.body.style.overflow = 'hidden';
    requestAnimationFrame(() => {
      cartSheetBackdrop.classList.add('open');
      cartSheet.classList.add('open');
    });
  }
  function closeCartSheet() {
    if (!cartSheet || !cartSheetBackdrop) return;
    cartSheet.classList.remove('open');
    cartSheetBackdrop.classList.remove('open');
    document.body.style.overflow = '';
    window.setTimeout(() => {
      if (cartSheet && !cartSheet.classList.contains('open')) {
        cartSheet.hidden = true;
        cartSheetBackdrop!.hidden = true;
      }
    }, 220);
  }
  function sheetQty(): number {
    return cartSheetQty ? Math.min(MAX_QTY, Math.max(1, Math.floor(Number(cartSheetQty.value) || 1))) : 1;
  }
  document.getElementById('cartSheetMinus')?.addEventListener('click', () => {
    if (cartSheetQty) cartSheetQty.value = String(Math.max(1, sheetQty() - 1));
  });
  document.getElementById('cartSheetPlus')?.addEventListener('click', () => {
    if (cartSheetQty) cartSheetQty.value = String(Math.min(MAX_QTY, sheetQty() + 1));
  });
  document.getElementById('cartSheetClose')?.addEventListener('click', closeCartSheet);
  cartSheetBackdrop?.addEventListener('click', closeCartSheet);
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && cartSheet && !cartSheet.hidden) closeCartSheet();
  });
  document.getElementById('cartSheetAdd')?.addEventListener('click', () => {
    if (!sheetProduct) return;
    addToCart(sheetProduct, sheetQty());
    closeCartSheet();
    // Cuộn lên đầu trang để thấy biểu tượng giỏ hàng (đã cập nhật số lượng) ngay sau khi thêm.
    waitScrollTop();
    showToast('Đã thêm vào giỏ hàng - hãy kiểm tra giỏ hàng');
  });
  document.getElementById('cartSheetBuy')?.addEventListener('click', () => {
    if (!sheetProduct) return;
    addToCart(sheetProduct, sheetQty());
    location.href = url('/gio-hang/');
  });

  // --- Nút "Thêm vào giỏ" / "Chọn mua" / "Mua ngay" ở mọi trang (thẻ sản phẩm, trang chi tiết) ---
  document.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-add-to-cart]');
    if (!button) return;
    const { id, name, price, originalPrice, unit, image, goCart, qtyInput: qtyInputSelector } = button.dataset;
    if (!id || !name) return;
    const product = {
      id,
      name,
      price: price ? Number(price) : null,
      originalPrice: originalPrice ? Number(originalPrice) : null,
      unit: unit ?? '',
      image: image ?? '',
    };

    // Thẻ sản phẩm (nút "Chọn mua", không có ô chọn số lượng riêng) trên điện thoại/máy tính bảng:
    // mở khay chọn số lượng thay vì thêm thẳng 1 sản phẩm. Trang chi tiết đã có ô chọn số lượng trên
    // trang nên bỏ qua khay này ở mọi kích thước màn hình.
    if (!isDesktop() && !qtyInputSelector) {
      openCartSheet(product);
      return;
    }

    const qtyInputEl = qtyInputSelector ? document.querySelector<HTMLInputElement>(qtyInputSelector) : null;
    const qty = qtyInputEl ? Math.min(MAX_QTY, Math.max(1, Math.floor(Number(qtyInputEl.value) || 1))) : 1;
    addToCart(product, qty);

    if (goCart !== undefined) {
      location.href = button.dataset.cartUrl ?? '/gio-hang/';
      return;
    }
    if (isDesktop()) {
      // Chụp ảnh + vị trí NGAY BÂY GIỜ (trước khi trang kịp cuộn), rồi mới cuộn lên đầu trang nếu
      // cần — để lúc bay/hiện khay, biểu tượng giỏ hàng chắc chắn đang trong khung nhìn.
      const source = findFlyImage(button);
      waitScrollTop().then(() => {
        if (source) {
          flyToCart(source.src, source.rect).then(flashCartDropdown);
        } else {
          flashCartDropdown();
        }
      });
    } else {
      // Cuộn lên đầu trang để thấy biểu tượng giỏ hàng (đã cập nhật số lượng) ngay sau khi thêm.
      waitScrollTop();
      showToast('Đã thêm vào giỏ hàng - hãy kiểm tra giỏ hàng');
    }
  });
</script>
