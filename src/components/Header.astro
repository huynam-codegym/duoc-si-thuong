---
import { categories } from '../lib/categories';
import { url } from '../lib/url';

const current = Astro.url.pathname;
---

<header class="site-header">
  <div class="container">
    <a class="brand" href={url('/')}>Dược Sĩ Thương</a>
    <nav class="site-nav" aria-label="Chuyên mục">
      <ul>
        {
          Object.entries(categories).map(([slug, category]) => (
            <li>
              <a href={url(`/${slug}/`)} aria-current={current.startsWith(url(`/${slug}/`)) ? 'page' : undefined}>
                {category.name}
              </a>
            </li>
          ))
        }
        <li>
          <a href={url('/tim-kiem/')} aria-current={current.startsWith(url('/tim-kiem/')) ? 'page' : undefined}>
            Tìm kiếm
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>
