---
// Mục "Video ngắn" ở trang chủ. Chỉ được gọi khi `videos` (src/lib/videos.ts) có ít nhất 1 video thật;
// xem điều kiện `videos.length > 0` ở nơi gọi component này (src/pages/index.astro).
// Video có `src` (file tự tải lên) bấm vào thì phát ngay trong khung nổi #videoDialog; video chỉ có `url`
// thì vẫn là liên kết mở tab mới như cũ.
import { Image, getImage } from 'astro:assets';
import type { VideoItem } from '../lib/videos';
import { url } from '../lib/url';

interface Props {
  videos: VideoItem[];
}

const { videos } = Astro.props;
const items = await Promise.all(
  videos.map(async (video) => ({
    ...video,
    poster: video.src ? (await getImage({ src: video.thumbnail, width: 540, format: 'webp' })).src : undefined,
  })),
);
const hasPlayer = items.some((video) => video.src);
---

<section aria-labelledby="video-ngan" class="video-section">
  <h2 class="section-title" id="video-ngan">Video ngắn</h2>
  <div class="video-carousel">
  {/* Khung cuộn ẩn thanh cuộn, máy tính dùng chuột không vuốt được: 2 nút cuộn đè 2 bên, ngang giữa
      ảnh video; nút nào hết chỗ cuộn thì ẩn */}
  <button type="button" class="video-nav-btn video-nav-prev" data-video-scroll="-1" aria-label="Xem video trước" hidden>‹</button>
  <button type="button" class="video-nav-btn video-nav-next" data-video-scroll="1" aria-label="Xem video tiếp theo" hidden>›</button>
  <div class="carousel">
    <div class="carousel-track video-track">
      {
        items.map((video) => {
          const inner = (
            <>
              <span class="video-thumb">
                <Image src={video.thumbnail} alt="" width={260} height={462} />
                <span class="video-play" aria-hidden="true">▶</span>
              </span>
              <span class="video-title">{video.title}</span>
            </>
          );
          return video.src ? (
            <button
              type="button"
              class="video-card"
              data-video-src={url(video.src)}
              data-video-poster={video.poster}
              data-video-title={video.title}
            >
              {inner}
            </button>
          ) : (
            <a class="video-card" href={video.url} target="_blank" rel="noopener noreferrer">
              {inner}
            </a>
          );
        })
      }
    </div>
  </div>
  </div>
</section>

{
  hasPlayer && (
    <dialog class="video-dialog" id="videoDialog" aria-labelledby="videoDialogTitle">
      <div class="video-dialog-box">
        <button type="button" class="video-dialog-close" aria-label="Đóng video">
          ✕
        </button>
        <video class="video-dialog-player" controls playsinline preload="none" />
        <p class="video-dialog-title" id="videoDialogTitle" />
      </div>
    </dialog>
  )
}

<script>
  const track = document.querySelector<HTMLElement>('.video-track');
  const wrap = document.querySelector<HTMLElement>('.video-carousel');
  if (track && wrap) {
    const prev = wrap.querySelector<HTMLButtonElement>('.video-nav-prev')!;
    const next = wrap.querySelector<HTMLButtonElement>('.video-nav-next')!;
    const thumb = track.querySelector<HTMLElement>('.video-thumb');
    const update = () => {
      const max = track.scrollWidth - track.clientWidth;
      prev.hidden = track.scrollLeft <= 2;
      next.hidden = track.scrollLeft >= max - 2;
      // Ngang giữa ảnh video (không tính dòng tiêu đề bên dưới)
      if (thumb) {
        const top = thumb.getBoundingClientRect().top - wrap.getBoundingClientRect().top + thumb.offsetHeight / 2;
        wrap.style.setProperty('--video-nav-top', `${top}px`);
      }
    };
    wrap.querySelectorAll<HTMLButtonElement>('[data-video-scroll]').forEach((btn) => {
      btn.addEventListener('click', () => {
        track.scrollBy({ left: Number(btn.dataset.videoScroll) * track.clientWidth * 0.8, behavior: 'smooth' });
      });
    });
    track.addEventListener('scroll', update, { passive: true });
    new ResizeObserver(update).observe(track);
    update();
  }

  const dialog = document.getElementById('videoDialog') as HTMLDialogElement | null;
  if (dialog) {
    const player = dialog.querySelector('video')!;
    const title = dialog.querySelector('.video-dialog-title')!;

    document.querySelectorAll<HTMLButtonElement>('.video-card[data-video-src]').forEach((card) => {
      card.addEventListener('click', () => {
        player.poster = card.dataset.videoPoster ?? '';
        player.src = card.dataset.videoSrc!;
        title.textContent = card.dataset.videoTitle ?? '';
        dialog.showModal();
        player.play().catch(() => {}); // trình duyệt chặn tự phát thì khách bấm ▶ trên khung
      });
    });

    dialog.querySelector('.video-dialog-close')!.addEventListener('click', () => dialog.close());
    // Bấm ra vùng tối bên ngoài khung thì đóng
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    // Đóng (kể cả bằng Esc) thì dừng hẳn và bỏ file, không để tiếng chạy ngầm hay tải tiếp
    dialog.addEventListener('close', () => {
      player.pause();
      player.removeAttribute('src');
      player.load();
    });
  }
</script>
