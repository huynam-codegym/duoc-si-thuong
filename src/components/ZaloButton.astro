---
import { site } from '../lib/site';

interface Props {
  label?: string;
}

const { label = 'Gọi ngay qua Zalo' } = Astro.props;
---

<a class="btn" href={site.zaloHref} target="_blank" rel="noopener noreferrer">
  <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="currentColor">
    <path
      d="M12 3C6.5 3 2 6.9 2 11.7c0 2.6 1.3 4.9 3.4 6.5-.1 1-.5 2.2-1.4 3.2a.5.5 0 0 0 .5.8c1.9-.2 3.5-1 4.5-1.7 1 .3 2 .4 3 .4 5.5 0 10-3.9 10-8.7S17.5 3 12 3z"
    ></path>
  </svg>
  <span>{label}: {site.phone}</span>
</a>
