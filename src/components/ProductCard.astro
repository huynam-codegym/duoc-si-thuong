---
import { Image } from 'astro:assets';
import { productGroups } from '../lib/product-groups';
import { formatPrice, type Product } from '../lib/products';
import { url } from '../lib/url';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const { name, summary, group, price, unit, image, imageAlt } = product.data;
---

<a class="card product-card" href={url(`/thuc-pham-chuc-nang/${product.id}/`)}>
  <Image class="product-thumb" src={image} alt={imageAlt} width={480} height={480} widths={[240, 480]} sizes="(min-width: 46rem) 14rem, 45vw" />
  <span class="tag">{productGroups[group].name}</span>
  <h3>{name}</h3>
  <p>{summary}</p>
  <p class="product-price">
    {formatPrice(price)}
    {unit && <span class="product-unit"> / {unit}</span>}
  </p>
</a>
