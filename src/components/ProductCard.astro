---
import { Image, getImage } from 'astro:assets';
import { departments } from '../lib/departments';
import { formatPrice, type Product } from '../lib/products';
import { url } from '../lib/url';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const { name, summary, department, group, price, unit, origin, image, imageAlt } = product.data;
// Ảnh nhỏ dùng trong giỏ hàng
const cartImage = await getImage({ src: image, width: 160, height: 160, format: 'webp' });
---

<div class="card product-card">
  <a class="product-link" href={url(`/${department}/${product.id}/`)}>
    <div class="product-thumb-wrap">
      <Image class="product-thumb" src={image} alt={imageAlt} width={480} height={480} widths={[240, 480]} sizes="(min-width: 46rem) 14rem, 45vw" />
      {origin && (
        <span class="origin-badge">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 3v18" />
            <path d="M5 4h13l-3 4.5L18 13H5" />
          </svg>
          {origin}
        </span>
      )}
    </div>
    <span class="tag">{departments[department].groups[group].name}</span>
    <h3>{name}</h3>
    <p>{summary}</p>
  </a>
  <p class="product-price">
    {formatPrice(price)}
    {unit && <span class="product-unit"> / {unit}</span>}
  </p>
  <button
    type="button"
    class="btn btn-add"
    data-add-to-cart
    data-id={product.id}
    data-name={name}
    data-price={price ?? ''}
    data-unit={unit ?? ''}
    data-image={cartImage.src}
  >
    Chọn mua
  </button>
</div>
