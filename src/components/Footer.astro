---
import Disclaimer from './Disclaimer.astro';
import { site } from '../lib/site';
import { url } from '../lib/url';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <Disclaimer />
    <p>
      Liên hệ tư vấn qua Zalo:
      <a href={site.zaloHref} target="_blank" rel="noopener noreferrer">{site.phone}</a> ·
      <a href={site.pharmacy.facebook} target="_blank" rel="noopener noreferrer">{site.pharmacy.name} trên Facebook</a> ·
      <a href={url('/gioi-thieu/')}>Giới thiệu</a>
    </p>
    <p>© {year} Dược Sĩ Thương. Chia sẻ kiến thức về ăn uống, nhận biết và phòng chống bệnh.</p>
  </div>
</footer>
